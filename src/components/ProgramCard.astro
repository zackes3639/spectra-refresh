---
import type { ProgramAccent } from "../data/programs";

interface Props {
	title: string;
	copy: string;
	href: string;
	accent: ProgramAccent;
	items?: string[];
	ctaLabel?: string;
}

const { title, copy, href, accent, items = [], ctaLabel = "Explore program" } = Astro.props;
---

<article class={`card program-card accent-${accent}`}>
	<span class="program-mark" aria-hidden="true"></span>
	<h3>{title}</h3>
	<p>{copy}</p>
	{items.length > 0 && (
		<ul>
			{items.map((item) => <li>{item}</li>)}
		</ul>
	)}
	<a href={href} aria-label={`${ctaLabel}: ${title}`}>{ctaLabel}</a>
</article>

<style>
	.program-card {
		position: relative;
		display: flex;
		min-height: 24rem;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(1.35rem, 3vw, 2rem);
		overflow: hidden;
	}

	.program-card::after {
		position: absolute;
		inset: auto -3rem -4rem auto;
		width: 11rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background:
			radial-gradient(circle, var(--accent-color), transparent 68%);
		content: "";
		opacity: 0.34;
	}

	.program-mark {
		width: 2.5rem;
		aspect-ratio: 1;
		border: 1px solid color-mix(in srgb, var(--accent-color), var(--color-deep-evergreen) 20%);
		border-radius: 50%;
		background:
			radial-gradient(circle at 34% 32%, rgba(255, 255, 255, 0.82) 0 18%, transparent 19%),
			linear-gradient(135deg, var(--accent-color), color-mix(in srgb, var(--accent-color), var(--color-spectra-teal) 34%));
		box-shadow: 0 10px 22px color-mix(in srgb, var(--accent-color), transparent 62%);
	}

	h3 {
		margin: var(--space-lg) 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 2.5vw, 2.2rem);
		font-weight: 400;
		line-height: 1.08;
	}

	p {
		margin: var(--space-md) 0 0;
		color: var(--color-muted);
	}

	ul {
		display: grid;
		gap: 0.55rem;
		padding: 0;
		margin: var(--space-lg) 0 var(--space-xl);
		list-style: none;
	}

	li {
		position: relative;
		padding-left: 1rem;
		color: var(--color-muted);
		font-size: 0.92rem;
	}

	li::before {
		position: absolute;
		top: 0.7em;
		left: 0;
		width: 0.35rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--accent-color);
		content: "";
	}

	a {
		position: relative;
		z-index: 1;
		margin-top: auto;
		color: color-mix(in srgb, var(--accent-color), var(--color-deep-evergreen) 58%);
		font-size: 0.88rem;
		font-weight: 800;
	}

	.accent-gold {
		--accent-color: var(--color-spectra-sun);
	}

	.accent-blue {
		--accent-color: var(--color-oxygen-blue);
	}

	.accent-lavender {
		--accent-color: var(--color-recovery-lavender);
	}

	.accent-coral {
		--accent-color: var(--color-warm-vitality-coral);
	}
</style>
