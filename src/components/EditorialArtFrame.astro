---
interface Props {
	src: string;
	alt?: string;
	caption?: string;
	aspect?: "wide" | "portrait" | "square";
	loading?: "eager" | "lazy";
}

const { src, alt = "", caption, aspect = "wide", loading = "lazy" } = Astro.props;
---

<figure class:list={["editorial-art-frame", `aspect-${aspect}`]}>
	<img src={src} alt={alt} loading={loading} decoding="async" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.editorial-art-frame {
		position: relative;
		display: grid;
		gap: var(--space-16);
		margin: 0;
	}

	.editorial-art-frame::before {
		position: absolute;
		inset: calc(var(--space-8) * -1);
		z-index: -1;
		border: 1px solid rgba(40, 156, 176, 0.16);
		border-radius: calc(var(--radius-xl) + var(--space-8));
		background:
			radial-gradient(circle at 15% 18%, rgba(40, 156, 176, 0.16), transparent 13rem),
			radial-gradient(circle at 85% 82%, rgba(226, 96, 151, 0.12), transparent 14rem),
			rgba(255, 255, 255, 0.42);
		content: "";
	}

	img {
		width: 100%;
		height: 100%;
		min-height: 0;
		object-fit: cover;
		border: 1px solid rgba(40, 156, 176, 0.18);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-soft);
	}

	.aspect-wide img {
		aspect-ratio: 16 / 10;
	}

	.aspect-portrait img {
		aspect-ratio: 4 / 5;
	}

	.aspect-square img {
		aspect-ratio: 1;
	}

	figcaption {
		margin: 0;
		color: var(--color-subtle);
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.4;
	}
</style>
