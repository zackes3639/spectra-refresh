---
import type { Program } from "../data/programs";
import CTASection from "./CTASection.astro";
import Layout from "./Layout.astro";
import PageHero from "./PageHero.astro";
import SectionIntro from "./SectionIntro.astro";

interface Props {
	program: Program;
}

const { program } = Astro.props;
---

<Layout
	title={`${program.title} | Dr. Lisa Koche`}
	description={`${program.title} is an education pathway from Dr. Lisa Koche for personalized, data-informed health literacy`}
	currentPath={`/programs/${program.slug}`}
>
	<PageHero
		title={program.title}
		copy={program.summary}
		primaryHref="/contact"
		primaryLabel="Ask About Fit"
		secondaryHref="/programs"
		secondaryLabel="Explore Programs"
		mediaLabel={`${program.title} imagery`}
	/>

	<section class="section" aria-labelledby="who-title">
		<div class="container detail-grid">
			<SectionIntro
				id="who-title"
				eyebrow="Fit"
				title="Who this is for"
				copy="Use this page as education and orientation for clearer questions and stronger self-advocacy"
			/>
			<div class="detail-list">
				{program.who.map((item) => <p>{item}</p>)}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="focus-title">
		<div class="container split-sections">
			<div>
				<SectionIntro id="focus-title" eyebrow="Focus" title="What we focus on" />
				<ul class="calm-list">
					{program.focus.map((item) => <li>{item}</li>)}
				</ul>
			</div>
			<div>
				<SectionIntro eyebrow="Included" title="What may be included" />
				<ul class="calm-list">
					{program.included.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="journey-title">
		<div class="container">
			<SectionIntro
				id="journey-title"
				eyebrow="Journey"
				title="A measured path from insight to refinement"
				copy="The exact learning path can be adapted to the questions you are trying to understand"
			/>
			<div class="journey-grid">
				{program.journey.map((step, index) => (
					<article class="journey-step">
						<span>{String(index + 1).padStart(2, "0")}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="outcome-title">
		<div class="container outcome-panel">
			<p class="eyebrow">Experience</p>
			<h2 id="outcome-title">Outcome-minded, without overpromising</h2>
			<p>{program.outcome}</p>
		</div>
	</section>

	<CTASection
		title="Start with a clearer picture of your physiology"
		copy="Return to the programs overview to compare Dr. Lisa's education pathways"
		primaryHref="/contact"
		primaryLabel="Contact"
		secondaryHref="/programs"
		secondaryLabel="Explore Programs"
	/>
</Layout>

<style>
	.detail-grid,
	.split-sections {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
	}

	.detail-list {
		display: grid;
		gap: var(--space-md);
	}

	.detail-list p {
		margin: 0;
		padding: var(--space-lg);
		border-top: 1px solid rgba(80, 166, 163, 0.26);
		color: var(--color-muted);
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0.7), transparent),
			var(--gradient-spectrum-soft);
	}

	.calm-list {
		display: grid;
		gap: var(--space-md);
		padding: 0;
		margin: var(--space-xl) 0 0;
		list-style: none;
	}

	.calm-list li {
		padding: var(--space-md) 0 var(--space-md) var(--space-lg);
		border-top: 1px solid rgba(80, 166, 163, 0.18);
		color: var(--color-muted);
	}

	.journey-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.journey-step {
		padding: clamp(1.25rem, 3vw, 1.8rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.68)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-card);
	}

	.journey-step span {
		color: var(--color-spectra-teal);
		font-family: var(--font-display);
	}

	.journey-step h3 {
		margin: var(--space-lg) 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 2.2vw, 2rem);
		font-weight: 400;
		line-height: 1.12;
	}

	.journey-step p,
	.outcome-panel p {
		color: var(--color-muted);
	}

	.outcome-panel {
		max-width: 52rem;
	}

	.outcome-panel h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 5vw, 4.6rem);
		font-weight: 400;
		line-height: 1;
	}

	@media (min-width: 760px) {
		.journey-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (min-width: 900px) {
		.detail-grid,
		.split-sections {
			grid-template-columns: 0.85fr 1fr;
			align-items: start;
		}
	}
</style>
