---
const links = [
	{ label: "About", href: "/about" },
	{ label: "Programs", href: "/programs" },
	{ label: "Approach", href: "/approach" },
	{ label: "Insights", href: "/insights" },
	{ label: "Speaking", href: "/speaking" },
	{ label: "Contact", href: "/contact" },
];
const legal = ["Privacy Placeholder", "Terms Placeholder", "Medical Disclaimer Placeholder"];
const social = ["LinkedIn", "Instagram", "YouTube"];
---

<footer class="site-footer" aria-label="Site footer">
	<div class="container footer-grid">
		<div>
			<a class="footer-brand" href="/">Dr. Lisa Koche</a>
			<p>
				A local-first static concept for a premium longevity medicine and physician authority brand.
			</p>
		</div>
		<nav aria-label="Footer site links">
			<h2>Site</h2>
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<nav aria-label="Professional and legal links">
			<h2>Professional</h2>
			{legal.map((link) => <a href="/contact">{link}</a>)}
		</nav>
		<nav aria-label="Social links">
			<h2>Social</h2>
			{social.map((link) => <a href="/contact">{link}</a>)}
		</nav>
	</div>
	<div class="container footer-bottom">
		<p>© 2026 Dr. Lisa Koche. Concept site only.</p>
		<p>Final legal, compliance, and medical review required before production.</p>
	</div>
</footer>

<style>
	.site-footer {
		padding: var(--space-2xl) 0 var(--space-xl);
		border-top: 1px solid var(--color-border);
		background: rgba(255, 255, 255, 0.42);
	}

	.footer-grid {
		display: grid;
		gap: var(--space-xl);
	}

	.footer-brand {
		font-family: var(--font-display);
		font-size: 1.5rem;
	}

	.footer-grid p {
		max-width: 24rem;
		margin: var(--space-sm) 0 0;
		color: var(--color-muted);
	}

	nav {
		display: grid;
		gap: 0.45rem;
		align-content: start;
	}

	h2 {
		margin: 0 0 var(--space-sm);
		color: var(--color-botanical-sage);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	nav a {
		color: var(--color-muted);
		font-size: 0.92rem;
		transition: color var(--transition);
	}

	nav a:hover {
		color: var(--color-deep-evergreen);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		justify-content: space-between;
		padding-top: var(--space-xl);
		margin-top: var(--space-xl);
		border-top: 1px solid rgba(49, 70, 58, 0.1);
		color: var(--color-subtle);
		font-size: 0.84rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (min-width: 780px) {
		.footer-grid {
			grid-template-columns: 1.4fr repeat(3, 1fr);
		}
	}
</style>
