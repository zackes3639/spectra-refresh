---
import BrandLogo from "./BrandLogo.astro";
import { isExternalUrl, practiceInfo, siteLinks } from "../data/site";

const exploreLinks = [
	{ label: "About", href: "/about" },
	{ label: "Approach", href: "/approach" },
	{ label: "Programs", href: "/programs" },
	{ label: "Resources", href: "/resources" },
	{ label: "Speaking", href: "/speaking" },
	{ label: "Media", href: "/media" },
];
const careLinks = [
	{ label: "Services", href: "/services" },
	{ label: "Functional Medicine", href: "/services/functional-medicine" },
	{ label: "Performance & Longevity", href: "/services/performance-longevity" },
	{ label: "IV Nutrition", href: "/services/iv-nutrition" },
	{ label: "Applied Kinesiology", href: "/services/applied-kinesiology" },
];
const practiceLinks = [
	{ label: "Clinical Practice", href: "/services" },
	{ label: "Care Model", href: "/membership" },
	{ label: "Care Team", href: "/team" },
	{ label: "Patient Info", href: "/patients" },
	{ label: "Patient Portal", href: siteLinks.patientPortal },
	{ label: "Mindbody Booking", href: siteLinks.mindbody },
	{ label: "Testimonials", href: "/testimonials" },
	{ label: "Contact", href: "/contact" },
];
const drLisaLinks = [
	{ label: "Free Resources", href: siteLinks.drLisaResources },
	{ label: "Courses", href: siteLinks.drLisaCourses },
	{ label: "Favorites", href: siteLinks.drLisaFavorites },
	{ label: "Academy Login", href: siteLinks.drLisaAcademy },
];
const legal = [
	{ label: "Privacy Policy", href: "/privacy" },
	{ label: "Terms of Service", href: "/terms" },
	{ label: "Medical Disclaimer", href: "/disclaimer" },
];
const social = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/lisa-koche-m-d-64a43a100/" },
	{ label: "Instagram", href: "https://www.instagram.com/drlisaskoche/" },
	{ label: "YouTube", href: "https://www.youtube.com/@spectrawellness" },
	{ label: "Practice Instagram", href: "https://www.instagram.com/spectrawellnesstampa/" },
];

const linkAttrs = (href: string) => (isExternalUrl(href) ? { target: "_blank", rel: "noopener noreferrer" } : {});
---

<footer class="site-footer" aria-label="Site footer">
	<div class="container footer-grid">
		<div class="footer-intro">
			<a class="footer-brand" href="/" aria-label="Dr. Lisa Koche home">
				<BrandLogo size="sm" showTagline={false} loading="lazy" />
			</a>
			<p>Dr. Lisa Koche's home for functional medicine education, longevity care, speaking, and whole-person health.</p>
			<p class="footer-contact">
				<a href={practiceInfo.phoneHref}>{practiceInfo.phone}</a><br />
				<a href={practiceInfo.emailHref}>{practiceInfo.email}</a><br />
				<a href={siteLinks.maps} {...linkAttrs(siteLinks.maps)}>{practiceInfo.address}</a>
			</p>
			<div class="footer-actions" aria-label="Footer calls to action">
				<a class="footer-action-link" href="/contact">Book discovery</a>
				<a class="footer-action-link" href="/about">Meet Dr. Lisa</a>
			</div>
		</div>
		<nav aria-label="Footer site links">
			<h2>Explore</h2>
			{exploreLinks.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Care pathway links">
			<h2>Care</h2>
			{careLinks.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Practice links">
			<h2>Practice</h2>
			{practiceLinks.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Dr. Lisa links">
			<h2>Dr. Lisa</h2>
			{drLisaLinks.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Professional and legal links">
			<h2>Legal</h2>
			{legal.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Social links">
			<h2>Connect</h2>
			{
				social.map((link) => (
					<a href={link.href} {...linkAttrs(link.href)}>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="container footer-bottom">
		<p>© 2026 Dr. Lisa Koche.</p>
		<p>Functional Medicine & Longevity Care</p>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		padding: clamp(1rem, 2vw, 1.45rem) 0 clamp(0.8rem, 1.6vw, 1.1rem);
		border-top: 1px solid var(--color-border);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(248, 253, 254, 0.82)),
			radial-gradient(circle at 10% 0%, rgba(215, 239, 244, 0.45), transparent 18rem);
	}

	.footer-grid {
		position: relative;
		display: grid;
		gap: clamp(0.85rem, 1.6vw, 1.2rem);
		align-items: start;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		width: min(13.5rem, 100%);
		max-width: 100%;
	}

	:global(.site-footer .footer-brand .brand-logo),
	:global(.site-footer .footer-brand .brand-logo picture) {
		width: 100%;
	}

	:global(.site-footer .footer-brand .brand-logo.brand-logo-sm img) {
		width: 100%;
		max-height: 3.15rem;
		mix-blend-mode: multiply;
	}

	.footer-intro {
		display: grid;
		gap: 0.58rem;
		max-width: 18rem;
	}

	.footer-intro p {
		margin: 0;
		color: rgba(22, 33, 40, 0.6);
		font-size: 0.82rem;
		line-height: 1.42;
	}

	.footer-contact a {
		color: var(--color-deep-evergreen);
		font-weight: 700;
	}

	.footer-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.8rem;
	}

	.footer-action-link {
		display: inline-flex;
		align-items: center;
		min-height: 1.3rem;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		color: var(--color-deep-evergreen);
		font-size: 0.78rem;
		font-weight: 800;
		line-height: 1;
		max-width: 100%;
		transition: color var(--transition);
	}

	.footer-action-link::after {
		width: 1.05rem;
		height: 1px;
		margin-left: 0.42rem;
		background: rgba(40, 156, 176, 0.42);
		content: "";
		transition:
			background-color var(--transition),
			transform var(--transition);
	}

	.footer-action-link:hover {
		color: var(--color-spectra-teal);
	}

	.footer-action-link:hover::after {
		background: var(--color-spectra-pink);
		transform: translateX(2px);
	}

	nav {
		display: grid;
		gap: 0.22rem;
		align-content: start;
	}

	h2 {
		margin: 0 0 0.45rem;
		color: var(--color-botanical-sage);
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	nav a {
		color: var(--color-muted);
		font-size: 0.82rem;
		line-height: 1.4;
		transition: color var(--transition);
	}

	nav a:hover {
		color: var(--color-deep-evergreen);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem var(--space-lg);
		justify-content: space-between;
		padding-top: 0.65rem;
		margin-top: clamp(0.75rem, 1.5vw, 1rem);
		border-top: 1px solid rgba(49, 70, 58, 0.1);
		color: var(--color-subtle);
		font-size: 0.76rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (min-width: 700px) and (max-width: 999px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer-intro {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 1000px) {
		.footer-grid {
			grid-template-columns: minmax(15rem, 1.35fr) repeat(6, minmax(6rem, 0.7fr));
			align-items: start;
		}
	}

	@media (max-width: 699px) {
		.site-footer {
			padding-top: var(--space-lg);
		}

		.footer-grid {
			gap: var(--space-sm) var(--space-md);
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer-intro {
			grid-column: 1 / -1;
		}

		.footer-actions {
			gap: 0.45rem 0.9rem;
		}

		nav {
			gap: 0.3rem;
		}

		h2 {
			margin-bottom: 0.3rem;
			font-size: 0.68rem;
		}

		nav a {
			font-size: 0.92rem;
			line-height: 1.4;
		}
	}

	@media (max-width: 380px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
