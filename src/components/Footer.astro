---
import BrandLogo from "./BrandLogo.astro";
import { isExternalUrl, siteLinks } from "../data/site";

const exploreLinks = [
	{ label: "About", href: "/about" },
	{ label: "Approach", href: "/approach" },
	{ label: "Programs", href: "/programs" },
	{ label: "Resources", href: "/resources" },
	{ label: "Speaking", href: "/speaking" },
	{ label: "Media", href: "/media" },
	{ label: "Contact", href: "/contact" },
];
const spectraLinks = [
	{ label: "Spectra Wellness", href: siteLinks.spectraWellness },
];
const drLisaLinks = [
	{ label: "Free Resources", href: siteLinks.drLisaResources },
	{ label: "Courses", href: siteLinks.drLisaCourses },
	{ label: "Favorites", href: siteLinks.drLisaFavorites },
	{ label: "Academy Login", href: siteLinks.drLisaAcademy },
];
const legal = [
	{ label: "Privacy Policy", href: "/privacy" },
	{ label: "Terms of Service", href: "/terms" },
	{ label: "Medical Disclaimer", href: "/disclaimer" },
];
const social = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/lisa-koche-m-d-64a43a100/" },
	{ label: "Instagram", href: "https://www.instagram.com/drlisaskoche/" },
	{ label: "YouTube", href: "https://www.youtube.com/@spectrawellness" },
];

const linkAttrs = (href: string) => (isExternalUrl(href) ? { target: "_blank", rel: "noopener noreferrer" } : {});
---

<footer class="site-footer" aria-label="Site footer">
	<div class="container footer-grid">
		<div class="footer-intro">
			<a class="footer-brand" href="/" aria-label="Dr. Lisa Koche home">
				<BrandLogo size="sm" showTagline={false} loading="lazy" />
			</a>
			<div class="footer-actions" aria-label="Footer calls to action">
				<a class="button button-primary footer-action-button" href="/contact">Contact</a>
				<a class="button button-secondary footer-action-button" href="/speaking">Speaking</a>
				<!-- Replace this fallback with Dr. Lisa's final book destination when approved. -->
				<a class="button button-secondary footer-action-button" href="/resources">My Book</a>
			</div>
		</div>
		<nav aria-label="Footer site links">
			<p class="footer-col-title">Explore</p>
			{exploreLinks.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Spectra Wellness links">
			<p class="footer-col-title">Spectra</p>
			{spectraLinks.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Dr. Lisa links">
			<p class="footer-col-title">Dr. Lisa</p>
			{drLisaLinks.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Professional and legal links">
			<p class="footer-col-title">Legal</p>
			{legal.map((link) => <a href={link.href} {...linkAttrs(link.href)}>{link.label}</a>)}
		</nav>
		<nav aria-label="Social links">
			<p class="footer-col-title">Connect</p>
			{
				social.map((link) => (
					<a href={link.href} {...linkAttrs(link.href)}>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="container footer-bottom">
		<p>© 2026 Dr. Lisa Koche</p>
		<p>Founder, Physician, Educator & Speaker</p>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		overflow: hidden;
		padding: clamp(1rem, 2vw, 1.45rem) 0 clamp(0.8rem, 1.6vw, 1.1rem);
		border-top: 1px solid var(--color-border);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(248, 253, 254, 0.82)),
			radial-gradient(circle at 10% 0%, rgba(215, 239, 244, 0.45), transparent 18rem);
	}

	.footer-grid {
		position: relative;
		display: grid;
		gap: clamp(0.85rem, 1.6vw, 1.2rem);
		align-items: start;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		align-self: start;
		width: min(13.5rem, 100%);
		max-width: 100%;
	}

	:global(.site-footer .footer-brand .brand-logo),
	:global(.site-footer .footer-brand .brand-logo picture) {
		width: 100%;
	}

	:global(.site-footer .footer-brand .brand-logo.brand-logo-sm img) {
		width: 100%;
		max-height: 3.15rem;
		mix-blend-mode: multiply;
	}

	.footer-intro {
		display: grid;
		gap: 0.58rem;
		max-width: 18rem;
	}

	.footer-intro p {
		margin: 0;
		color: rgba(22, 33, 40, 0.6);
		font-size: 0.82rem;
		line-height: 1.42;
	}

	.footer-contact a {
		color: var(--color-deep-evergreen);
		font-weight: 700;
	}

	.footer-actions {
		display: grid;
		gap: 0.48rem;
		margin-top: 0;
		width: min(13.5rem, 100%);
	}

	.footer-action-button {
		justify-content: center;
		min-height: 2.05rem;
		width: 100%;
		padding: 0.44rem 0.9rem;
		font-size: 0.76rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0;
		white-space: nowrap;
	}

	nav {
		display: grid;
		gap: 0.22rem;
		align-content: start;
	}

	.footer-col-title {
		margin: 0 0 0.45rem;
		color: var(--color-botanical-sage);
		font-size: 0.66rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	nav a {
		color: var(--color-muted);
		font-size: 0.82rem;
		line-height: 1.4;
		transition: color var(--transition);
	}

	nav a:hover {
		color: var(--color-deep-evergreen);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem var(--space-lg);
		justify-content: space-between;
		padding-top: 0.65rem;
		margin-top: clamp(0.75rem, 1.5vw, 1rem);
		border-top: 1px solid rgba(49, 70, 58, 0.1);
		color: var(--color-subtle);
		font-size: 0.76rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (min-width: 700px) and (max-width: 999px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer-intro {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 1000px) {
		.footer-grid {
			grid-template-columns: minmax(15rem, 1.35fr) repeat(5, minmax(6rem, 0.7fr));
			align-items: start;
		}
	}

	@media (max-width: 699px) {
		.site-footer {
			padding-top: var(--space-lg);
		}

		.footer-grid {
			gap: var(--space-sm) var(--space-md);
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer-intro {
			grid-column: 1 / -1;
		}

		.footer-actions {
			gap: 0.52rem;
		}

		nav {
			gap: 0.3rem;
		}

		.footer-col-title {
			margin-bottom: 0.3rem;
			font-size: 0.68rem;
		}

		nav a {
			font-size: 0.92rem;
			line-height: 1.4;
		}
	}

	@media (max-width: 380px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
