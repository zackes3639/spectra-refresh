---
import { siteLinks } from "../data/site";

interface Props {
	title?: string;
	copy?: string;
}

const {
	title = "Continue to Spectra Wellness",
	copy = "Practice details, appointments, and office information now live on the Spectra Wellness site",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="refresh" content={`0; url=${siteLinks.spectraWellness}`} />
		<link rel="canonical" href={siteLinks.spectraWellness} />
		<title>{title}</title>
		<style>
			body {
				display: grid;
				min-height: 100vh;
				margin: 0;
				place-items: center;
				background: #f5f7fb;
				color: #162128;
				font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			}

			main {
				width: min(100% - 2rem, 34rem);
				text-align: center;
			}

			a {
				color: #289cb0;
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<main>
			<h1>{title}</h1>
			<p>{copy}</p>
			<p><a href={siteLinks.spectraWellness}>Open Spectra Wellness</a></p>
		</main>
	</body>
</html>
