---
import IconMark, { type IconMarkName } from "./IconMark.astro";
import { isExternalUrl } from "../data/site";
import { widont } from "../utils/typography";

interface Props {
	title: string;
	copy: string;
	href?: string;
	eyebrow?: string;
	index?: number;
	icon?: IconMarkName;
	ctaLabel?: string;
}

const { title, copy, href, eyebrow, index, icon, ctaLabel = "Learn more" } = Astro.props;
const linkAttrs = href && isExternalUrl(href) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
	href ? (
		<a class="pathway-card" href={href} {...linkAttrs}>
			{icon ? <IconMark name={icon} /> : <span class="pathway-mark" aria-hidden="true">{index ? String(index).padStart(2, "0") : ""}</span>}
			<div>
				{eyebrow && <p>{eyebrow}</p>}
				<h3 set:html={widont(title)} />
				<span set:html={widont(copy)} />
			</div>
			<strong class="pathway-cta">{ctaLabel}<span class="pathway-chevron" aria-hidden="true">&rarr;</span></strong>
		</a>
	) : (
		<article class="pathway-card">
			{icon ? <IconMark name={icon} /> : <span class="pathway-mark" aria-hidden="true">{index ? String(index).padStart(2, "0") : ""}</span>}
			<div>
				{eyebrow && <p>{eyebrow}</p>}
				<h3 set:html={widont(title)} />
				<span set:html={widont(copy)} />
			</div>
		</article>
	)
}

<style>
	.pathway-card {
		position: relative;
		display: grid;
		gap: var(--space-24);
		align-content: start;
		min-height: 14rem;
		padding: clamp(var(--space-24), 2.6vw, var(--space-32));
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(circle at 92% 8%, rgba(215, 239, 244, 0.55), transparent 9rem),
			linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.74));
		box-shadow: var(--shadow-card);
		transition:
			transform var(--transition),
			border-color var(--transition),
			box-shadow var(--transition);
	}

	a.pathway-card:hover {
		border-color: rgba(226, 96, 151, 0.32);
		box-shadow: var(--shadow-lift);
		transform: translateY(-2px);
	}

	.pathway-mark {
		display: inline-grid;
		width: 2.45rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid rgba(40, 156, 176, 0.22);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.62);
		color: var(--color-spectra-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		box-shadow: inset 0 0 0 0.34rem rgba(215, 239, 244, 0.44);
	}

	p {
		margin: 0 0 var(--space-xs);
		color: var(--color-spectra-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 2.25vw, 2rem);
		font-weight: 400;
		line-height: 1.08;
	}

	div > span {
		display: block;
		margin-top: var(--space-12);
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	strong {
		align-self: end;
		margin-top: var(--space-8);
		color: var(--color-spectra-teal);
		font-size: 0.86rem;
		font-weight: 800;
		line-height: 1;
	}

	/* Chevron affordance signals the whole card is clickable. */
	.pathway-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.pathway-chevron {
		transition: transform var(--transition);
	}

	a.pathway-card:hover .pathway-chevron,
	a.pathway-card:focus-visible .pathway-chevron {
		transform: translateX(0.25rem);
	}

	@media (min-width: 760px) and (max-width: 999px) {
		h3 {
			font-size: clamp(1.32rem, 2vw, 1.7rem);
			line-height: 1.12;
		}
	}
</style>
