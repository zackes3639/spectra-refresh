---
import type { Testimonial } from "../data/testimonials";
import { widont } from "../utils/typography";

interface Props {
	testimonials: Testimonial[];
}

const { testimonials } = Astro.props;

const themeLabels: Record<Testimonial["theme"], string> = {
	"root-cause": "Root-cause clarity",
	heard: "Feeling heard",
	team: "Team experience",
	functional: "Continuity of care",
	structural: "Structural support",
};
---

<div class="testimonial-rail" aria-label="Patient testimonial themes">
	{
		testimonials.map((testimonial) => (
			<article>
				<p set:html={widont(themeLabels[testimonial.theme])} />
				<blockquote set:html={widont(testimonial.excerpt)} />
				<span>{testimonial.name}</span>
			</article>
		))
	}
</div>

<style>
	.testimonial-rail {
		display: grid;
		grid-auto-columns: minmax(min(20rem, 82vw), 1fr);
		grid-auto-flow: column;
		gap: var(--space-lg);
		overflow-x: auto;
		padding: var(--space-4) 0 var(--space-16);
		scroll-snap-type: x proximity;
	}

	article {
		display: grid;
		min-height: 18rem;
		align-content: start;
		padding: clamp(var(--space-24), 2.8vw, var(--space-32));
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(247, 252, 254, 0.68)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-card);
		scroll-snap-align: start;
	}

	p {
		margin: 0 0 var(--space-40);
		color: var(--color-spectra-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	blockquote {
		margin: 0;
		color: var(--color-deep-evergreen);
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 1.9vw, 1.7rem);
		font-weight: 400;
		line-height: 1.24;
	}

	span {
		display: block;
		margin-top: var(--space-lg);
		color: var(--color-muted);
		font-size: 0.88rem;
		font-weight: 800;
	}

	@media (min-width: 900px) {
		.testimonial-rail {
			grid-auto-flow: initial;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			overflow: visible;
			padding-bottom: 0;
		}
	}
</style>
