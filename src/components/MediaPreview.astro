---
const mediaItems = [
	"Podcast conversation on preventive longevity medicine",
	"Keynote conversation on human-centered health technology",
	"Press feature on root-cause care and metabolic resilience",
];
---

<section class="section" id="speaking" aria-labelledby="media-title">
	<div class="container media-grid">
		<div>
			<p class="eyebrow">Speaking & Media</p>
			<h2 class="section-heading" id="media-title">A physician voice for a more intelligent health conversation.</h2>
			<p class="section-copy">
				Dr. Koche's platform can extend into talks, podcasts, press, and education that translate
				complex physiology into clear, humane action.
			</p>
			<a class="button button-secondary media-link" href="/speaking">Explore Speaking & Media</a>
		</div>
		<div class="media-panel">
			<!-- Replace these placeholders with final podcast, talk, and press artwork or logos. -->
			<p class="placeholder-note">Recent Appearances</p>
			<ul>
				{mediaItems.map((item) => (
					<li>
						<span aria-hidden="true"></span>
						{item}
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.media-grid {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
	}

	.media-panel {
		padding: clamp(1.35rem, 3vw, 2rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.78), rgba(220, 239, 238, 0.56)),
			radial-gradient(circle at 84% 10%, rgba(216, 76, 159, 0.16), transparent 12rem),
			radial-gradient(circle at 10% 88%, rgba(244, 201, 93, 0.16), transparent 12rem);
		box-shadow: var(--shadow-spectrum);
	}

	.media-panel ul {
		display: grid;
		gap: var(--space-md);
		padding: 0;
		margin: var(--space-xl) 0 0;
		list-style: none;
	}

	.media-panel li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-md);
		align-items: center;
		padding-block: var(--space-md);
		border-top: 1px solid rgba(80, 166, 163, 0.16);
		color: var(--color-muted);
	}

	.media-panel li span {
		width: 2rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--gradient-spectrum);
	}

	.media-link {
		width: fit-content;
		margin-top: var(--space-xl);
	}

	@media (min-width: 860px) {
		.media-grid {
			grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.72fr);
		}
	}
</style>
