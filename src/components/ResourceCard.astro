---
import { isExternalUrl } from "../data/site";
import type { Resource } from "../data/resources";

interface Props {
	resource: Resource;
	featured?: boolean;
}

const { resource, featured = false } = Astro.props;
const linkAttrs = isExternalUrl(resource.href) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<article class:list={["card resource-card", featured && "featured"]}>
	<p>{resource.type.replace("-", " ")} - {resource.sourceSite === "dr-lisa" ? "Dr. Lisa" : "Practice"}</p>
	<h3>{resource.title}</h3>
	<span>{resource.summary}</span>
	<a href={resource.href} {...linkAttrs}>{resource.ctaLabel}</a>
</article>

<style>
	.resource-card {
		display: flex;
		min-height: 18rem;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(1.25rem, 3vw, 1.9rem);
	}

	.featured {
		min-height: 21rem;
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.86), rgba(220, 239, 238, 0.58)),
			radial-gradient(circle at 86% 12%, rgba(244, 201, 93, 0.22), transparent 10rem),
			radial-gradient(circle at 12% 90%, rgba(216, 76, 159, 0.12), transparent 10rem);
	}

	p {
		margin: 0 0 var(--space-lg);
		color: var(--color-spectra-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 2.4vw, 2rem);
		font-weight: 400;
		line-height: 1.1;
	}

	span {
		display: block;
		margin-top: var(--space-md);
		color: var(--color-muted);
	}

	a {
		margin-top: auto;
		color: var(--color-spectra-teal);
		font-size: 0.88rem;
		font-weight: 800;
	}
</style>
