---
import { isExternalUrl } from "../data/site";

interface Props {
	eyebrow?: string;
	title: string;
	copy: string;
	primaryHref: string;
	primaryLabel: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	singleLineTitle?: boolean;
}

const {
	eyebrow = "Begin",
	title,
	copy,
	primaryHref,
	primaryLabel,
	secondaryHref,
	secondaryLabel,
	singleLineTitle = false,
} = Astro.props;

const primaryAttrs = isExternalUrl(primaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
const secondaryAttrs = secondaryHref && isExternalUrl(secondaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<section class="final-cta" aria-labelledby="cta-title">
	<div class:list={["container final-cta-panel", singleLineTitle && "single-line-layout"]}>
		<div>
			<p class="eyebrow">{eyebrow}</p>
			<h2 class:list={[singleLineTitle && "single-line-title"]} id="cta-title">{title}</h2>
			<p>{copy}</p>
		</div>
		<div class="final-actions">
			<a class="button button-primary" href={primaryHref} {...primaryAttrs}>{primaryLabel}</a>
			{secondaryHref && secondaryLabel && <a class="button button-secondary" href={secondaryHref} {...secondaryAttrs}>{secondaryLabel}</a>}
		</div>
	</div>
</section>

<style>
	.final-cta {
		padding: 0 0 clamp(2.35rem, 4.8vw, 4rem);
	}

	.final-cta-panel {
		display: grid;
		gap: var(--space-xl);
		align-items: end;
		padding: clamp(1.5rem, 5vw, 4rem);
		border: 1px solid rgba(80, 166, 163, 0.36);
		border-radius: var(--radius-xl);
		background:
			radial-gradient(circle at 12% 18%, rgba(80, 166, 163, 0.35), transparent 14rem),
			radial-gradient(circle at 82% 16%, rgba(216, 76, 159, 0.28), transparent 16rem),
			radial-gradient(circle at 88% 88%, rgba(244, 201, 93, 0.2), transparent 15rem),
			var(--gradient-evergreen-spectrum);
		color: var(--color-warm-clinical-white);
		box-shadow: var(--shadow-spectrum);
	}

	.final-cta .eyebrow {
		color: var(--color-spectra-sun);
	}

	h2 {
		max-width: 46rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 4.3vw, 4.6rem);
		font-weight: 400;
		line-height: 1.02;
	}

	h2.single-line-title {
		max-width: none;
		font-size: clamp(2rem, 3.6vw, 3.65rem);
		white-space: normal;
		text-wrap: balance;
	}

	p {
		max-width: 40rem;
		margin: var(--space-md) 0 0;
		color: rgba(247, 248, 245, 0.72);
	}

	.final-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.final-cta-panel.single-line-layout .final-actions {
		margin-top: var(--space-sm);
		justify-content: flex-start;
	}

	.final-cta-panel.single-line-layout p {
		max-width: 56rem;
		font-size: clamp(1rem, 1.22vw, 1.2rem);
		line-height: 1.55;
	}

	.final-cta .button-secondary {
		border-color: rgba(247, 248, 245, 0.28);
		color: var(--color-warm-clinical-white);
	}

	.final-cta .button-secondary:hover {
		background: rgba(247, 248, 245, 0.1);
	}

	@media (min-width: 900px) {
		.final-cta-panel {
			grid-template-columns: 1fr auto;
		}

		.final-cta-panel.single-line-layout {
			grid-template-columns: 1fr;
		}
	}

	@media (min-width: 1100px) {
		h2.single-line-title {
			white-space: nowrap;
		}
	}

	@media (max-width: 720px) {
		h2.single-line-title {
			font-size: clamp(1.95rem, 8vw, 2.6rem);
			white-space: normal;
		}

		.final-actions .button {
			flex: 1 1 100%;
		}
	}
</style>
