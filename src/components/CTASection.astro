---
import { isExternalUrl } from "../data/site";
import { widont } from "../utils/typography";

interface Props {
	eyebrow?: string;
	title: string;
	copy: string;
	primaryHref: string;
	primaryLabel: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	singleLineTitle?: boolean;
	compactLayout?: boolean;
}

const {
	eyebrow = "Begin",
	title,
	copy,
	primaryHref,
	primaryLabel,
	secondaryHref,
	secondaryLabel,
	singleLineTitle = false,
	compactLayout = false,
} = Astro.props;

const primaryAttrs = isExternalUrl(primaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
const secondaryAttrs = secondaryHref && isExternalUrl(secondaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<section class="final-cta" aria-labelledby="cta-title">
	<div class:list={["container final-cta-panel", singleLineTitle && "single-line-layout", compactLayout && "compact-layout"]}>
		<div class="final-cta-copy">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 class:list={[singleLineTitle && "single-line-title"]} id="cta-title" set:html={widont(title)} />
			{!compactLayout && <p set:html={widont(copy)} />}
		</div>
		{
			compactLayout ? (
				<div class="final-cta-side">
					<p set:html={widont(copy)} />
					<div class="final-actions">
						<a class="button button-primary" href={primaryHref} {...primaryAttrs}>{primaryLabel}</a>
						{secondaryHref && secondaryLabel && <a class="button button-secondary" href={secondaryHref} {...secondaryAttrs}>{secondaryLabel}</a>}
					</div>
				</div>
			) : (
				<div class="final-actions">
					<a class="button button-primary" href={primaryHref} {...primaryAttrs}>{primaryLabel}</a>
					{secondaryHref && secondaryLabel && <a class="button button-secondary" href={secondaryHref} {...secondaryAttrs}>{secondaryLabel}</a>}
				</div>
			)
		}
	</div>
</section>

<style>
	.final-cta {
		padding: 0 0 clamp(var(--space-40), 5vw, var(--space-64));
	}

	.final-cta-panel {
		display: grid;
		gap: var(--space-xl);
		align-items: end;
		padding: clamp(var(--space-32), 5vw, var(--space-64));
		border: 1px solid rgba(80, 166, 163, 0.36);
		border-radius: var(--radius-xl);
		background:
			radial-gradient(circle at 12% 18%, rgba(80, 166, 163, 0.35), transparent 14rem),
			radial-gradient(circle at 82% 16%, rgba(216, 76, 159, 0.28), transparent 16rem),
			radial-gradient(circle at 88% 88%, rgba(244, 201, 93, 0.2), transparent 15rem),
			var(--gradient-evergreen-spectrum);
		color: var(--color-warm-clinical-white);
		box-shadow: var(--shadow-spectrum);
	}

	.final-cta .eyebrow {
		color: var(--color-spectra-sun);
	}

	h2 {
		max-width: min(46rem, var(--max-text-width));
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.1rem, 4.3vw, 4.6rem);
		font-weight: 400;
		line-height: var(--heading-line-height);
	}

	h2.single-line-title {
		max-width: none;
		font-size: clamp(2rem, 3.6vw, 3.65rem);
		white-space: normal;
		text-wrap: balance;
	}

	p {
		max-width: min(40rem, var(--max-text-width));
		margin: var(--space-md) 0 0;
		color: rgba(247, 248, 245, 0.72);
	}

	.final-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.final-cta-panel.single-line-layout .final-actions {
		margin-top: var(--space-sm);
		justify-content: flex-start;
	}

	.final-cta-panel.single-line-layout p {
		max-width: 56rem;
		font-size: clamp(1rem, 1.22vw, 1.2rem);
		line-height: 1.55;
	}

	.final-cta-panel.compact-layout {
		grid-template-columns: 1fr;
		place-items: center;
		gap: var(--space-lg);
		padding: clamp(var(--space-32), 4vw, var(--space-56));
		text-align: center;
	}

	.final-cta-panel.compact-layout h2 {
		max-width: 44rem;
		font-size: clamp(2.65rem, 4vw, 4rem);
		line-height: 1.02;
	}

	.final-cta-side {
		display: grid;
		gap: var(--space-md);
		justify-items: center;
	}

	.final-cta-side p {
		max-width: 38rem;
		margin: 0;
		font-size: clamp(1rem, 1.1vw, 1.12rem);
		line-height: 1.55;
		text-align: center;
	}

	.final-cta-panel.compact-layout .final-actions {
		justify-content: center;
		gap: 0.8rem;
		width: 100%;
	}

	.final-cta-panel.compact-layout .button {
		justify-content: center;
		min-width: 10.75rem;
	}

	.final-cta .button-secondary {
		border-color: rgba(247, 248, 245, 0.28);
		color: var(--color-warm-clinical-white);
	}

	.final-cta .button-secondary:hover {
		background: rgba(247, 248, 245, 0.1);
	}

	@media (min-width: 900px) {
		.final-cta-panel {
			grid-template-columns: 1fr auto;
		}

		.final-cta-panel.single-line-layout {
			grid-template-columns: 1fr;
		}

		.final-cta-panel.compact-layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 899px) {
		.final-cta-panel.compact-layout .final-actions .button {
			flex: 1 1 100%;
		}
	}

	@media (min-width: 1100px) {
		h2.single-line-title {
			white-space: nowrap;
		}
	}

	@media (max-width: 720px) {
		h2.single-line-title {
			font-size: clamp(1.95rem, 8vw, 2.6rem);
			white-space: normal;
		}

		.final-actions .button {
			flex: 1 1 100%;
		}
	}
</style>
