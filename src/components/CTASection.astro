---
interface Props {
	eyebrow?: string;
	title: string;
	copy: string;
	primaryHref: string;
	primaryLabel: string;
	secondaryHref?: string;
	secondaryLabel?: string;
}

const { eyebrow = "Begin", title, copy, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="final-cta" aria-labelledby="cta-title">
	<div class="container final-cta-panel">
		<div>
			<p class="eyebrow">{eyebrow}</p>
			<h2 id="cta-title">{title}</h2>
			<p>{copy}</p>
		</div>
		<div class="final-actions">
			<a class="button button-primary" href={primaryHref}>{primaryLabel}</a>
			{secondaryHref && secondaryLabel && <a class="button button-secondary" href={secondaryHref}>{secondaryLabel}</a>}
		</div>
	</div>
</section>

<style>
	.final-cta {
		padding-block: var(--space-3xl);
	}

	.final-cta-panel {
		display: grid;
		gap: var(--space-xl);
		align-items: end;
		padding: clamp(1.5rem, 5vw, 4rem);
		border: 1px solid rgba(80, 166, 163, 0.36);
		border-radius: var(--radius-xl);
		background:
			radial-gradient(circle at 12% 18%, rgba(80, 166, 163, 0.35), transparent 14rem),
			radial-gradient(circle at 82% 16%, rgba(216, 76, 159, 0.28), transparent 16rem),
			radial-gradient(circle at 88% 88%, rgba(244, 201, 93, 0.2), transparent 15rem),
			var(--gradient-evergreen-spectrum);
		color: var(--color-warm-clinical-white);
		box-shadow: var(--shadow-spectrum);
	}

	.final-cta .eyebrow {
		color: var(--color-spectra-sun);
	}

	h2 {
		max-width: 46rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.3rem, 5vw, 5rem);
		font-weight: 400;
		line-height: 1;
	}

	p {
		max-width: 40rem;
		margin: var(--space-md) 0 0;
		color: rgba(247, 248, 245, 0.72);
	}

	.final-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
	}

	.final-cta .button-secondary {
		border-color: rgba(247, 248, 245, 0.28);
		color: var(--color-warm-clinical-white);
	}

	.final-cta .button-secondary:hover {
		background: rgba(247, 248, 245, 0.1);
	}

	@media (min-width: 900px) {
		.final-cta-panel {
			grid-template-columns: 1fr auto;
		}
	}
</style>
