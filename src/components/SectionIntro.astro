---
import { widont } from "../utils/typography";

interface Props {
	id?: string;
	eyebrow?: string;
	title: string;
	copy?: string;
	align?: "left" | "center";
}

const { id, eyebrow, title, copy, align = "left" } = Astro.props;
---

<div class={`section-intro align-${align}`}>
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<h2 class="section-heading" id={id} set:html={widont(title)} />
	{copy && <p class="section-copy" set:html={widont(copy)} />}
</div>

<style>
	.section-intro {
		max-width: min(52rem, var(--max-text-width));
	}

	.align-center {
		margin-inline: auto;
		text-align: center;
	}

	.align-center .section-copy {
		margin-inline: auto;
	}
</style>
