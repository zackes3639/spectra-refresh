---
interface Props {
	title: string;
	copy: string;
}

const { title, copy } = Astro.props;
---

<article class="card credential-card">
	<span aria-hidden="true"></span>
	<h3>{title}</h3>
	<p>{copy}</p>
</article>

<style>
	.credential-card {
		display: grid;
		align-content: start;
		min-height: 16rem;
		padding: clamp(1.25rem, 3vw, 1.85rem);
	}

	span {
		width: 2.25rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--gradient-spectrum);
		box-shadow: 0 12px 24px rgba(80, 166, 163, 0.18);
	}

	h3 {
		margin: var(--space-xl) 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2vw, 1.9rem);
		font-weight: 400;
		line-height: 1.12;
	}

	p {
		margin: var(--space-md) 0 0;
		color: var(--color-muted);
	}
</style>
