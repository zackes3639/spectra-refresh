---
const items = [
	{ label: "Physician-Led Care", color: "teal" },
	{ label: "Advanced Diagnostics", color: "blue" },
	{ label: "Personalized Protocols", color: "pink" },
	{ label: "Long-Term Optimization", color: "sun" },
];
---

<section class="authority-strip" aria-label="Care pillars">
	<div class="container authority-inner">
		{items.map((item) => (
			<div class={`authority-item accent-${item.color}`}>
				<span aria-hidden="true"></span>
				<strong>{item.label}</strong>
			</div>
		))}
	</div>
</section>

<style>
	.authority-strip {
		padding-block: var(--space-xl);
	}

	.authority-inner {
		display: grid;
		gap: 1px;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--gradient-spectrum);
		box-shadow: var(--shadow-spectrum);
	}

	.authority-item {
		display: flex;
		gap: var(--space-sm);
		align-items: center;
		min-height: 5rem;
		padding: var(--space-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.72)),
			radial-gradient(circle at 90% 12%, var(--item-glow), transparent 8rem);
	}

	.authority-item span {
		width: 0.55rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--item-color);
		box-shadow: 0 0 0 0.45rem var(--item-glow);
	}

	.accent-teal {
		--item-color: var(--color-spectra-teal);
		--item-glow: rgba(80, 166, 163, 0.18);
	}

	.accent-blue {
		--item-color: var(--color-oxygen-blue);
		--item-glow: rgba(125, 183, 217, 0.18);
	}

	.accent-pink {
		--item-color: var(--color-spectra-pink);
		--item-glow: rgba(216, 76, 159, 0.16);
	}

	.accent-sun {
		--item-color: var(--color-spectra-sun);
		--item-glow: rgba(244, 201, 93, 0.2);
	}

	.authority-item strong {
		font-family: var(--font-display);
		font-size: 1.16rem;
		font-weight: 400;
		line-height: 1.2;
	}

	@media (min-width: 760px) {
		.authority-inner {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
