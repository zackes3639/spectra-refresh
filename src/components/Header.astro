---
import BrandLogo from "./BrandLogo.astro";

interface Props {
	currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
	{ label: "About", href: "/about" },
	{ label: "Programs", href: "/programs" },
	{ label: "Approach", href: "/approach" },
	{ label: "Insights", href: "/insights" },
	{ label: "Speaking", href: "/speaking" },
	{ label: "Contact", href: "/contact" },
];

const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
const activePath = normalizePath(currentPath);
const isActive = (href: string) =>
	href === "/programs"
		? activePath === "/programs" || activePath.startsWith("/programs/")
		: activePath === href;
---

<header class="site-header" aria-label="Primary navigation">
	<div class="container header-inner">
		<a class="brand" href="/" aria-label="Dr. Lisa Koche home">
			<BrandLogo size="md" showTagline={true} loading="eager" />
		</a>
		<nav class="nav-links nav-desktop" aria-label="Main menu">
			{
				navItems.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
		<a class="button button-primary header-cta desktop-cta" href="/contact">Contact</a>
		<details class="mobile-menu">
			<summary aria-label="Open navigation menu">
				<span>Menu</span>
			</summary>
			<div class="mobile-panel">
				<nav class="nav-links nav-mobile" aria-label="Mobile menu">
					{
						navItems.map((item) => (
							<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="button button-primary header-cta mobile-cta" href="/contact">Contact</a>
			</div>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.92), rgba(248, 254, 255, 0.9));
		border-bottom: 1px solid rgba(80, 166, 163, 0.18);
		backdrop-filter: blur(20px);
	}

	.header-inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-sm);
		align-items: center;
		padding-block: 0.85rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		max-width: min(18rem, 58vw);
	}

	.nav-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
		align-items: center;
		color: rgba(22, 33, 40, 0.7);
		font-size: clamp(0.84rem, 0.36vw + 0.74rem, 0.92rem);
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.nav-links a {
		padding: 0.4rem 0.15rem;
		transition: color var(--transition);
	}

	.nav-links a:hover {
		color: var(--color-deep-evergreen);
	}

	.nav-links a[aria-current="page"] {
		color: var(--color-deep-evergreen);
	}

	.nav-links a[aria-current="page"]::after {
		display: block;
		width: 100%;
		height: 2px;
		margin-top: 0.2rem;
		background: var(--gradient-spectrum);
		content: "";
	}

	.header-cta {
		width: fit-content;
	}

	.mobile-menu {
		position: relative;
	}

	.mobile-menu summary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.58rem 0.95rem;
		border: 1px solid rgba(40, 156, 176, 0.34);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.74);
		color: var(--color-deep-evergreen);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		list-style: none;
		cursor: pointer;
		user-select: none;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu[open] summary {
		border-color: rgba(216, 76, 159, 0.34);
	}

	.mobile-panel {
		position: absolute;
		right: 0;
		z-index: 30;
		width: min(19rem, calc(100vw - (var(--gutter) * 2)));
		padding: var(--space-md);
		margin-top: 0.55rem;
		border: 1px solid rgba(40, 156, 176, 0.24);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(248, 254, 255, 0.93)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-soft);
	}

	.nav-mobile {
		display: grid;
		gap: 0.2rem;
		font-size: 0.84rem;
		letter-spacing: 0.04em;
	}

	.nav-mobile a {
		padding: 0.46rem 0.22rem;
	}

	.mobile-cta {
		width: 100%;
		margin-top: var(--space-sm);
	}

	@media (min-width: 940px) {
		.header-inner {
			grid-template-columns: auto 1fr auto;
		}

		.nav-desktop {
			justify-content: center;
		}

		.mobile-menu {
			display: none;
		}
	}

	@media (max-width: 939px) {
		.nav-desktop,
		.desktop-cta {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.brand {
			max-width: min(14rem, 54vw);
		}
	}
</style>
