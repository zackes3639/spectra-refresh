---
import BrandLogo from "./BrandLogo.astro";

interface Props {
	currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
	{ label: "About", href: "/about" },
	{ label: "Approach", href: "/approach" },
	{ label: "Services", href: "/services" },
	{ label: "Programs", href: "/programs" },
	{ label: "Resources", href: "/resources" },
	{ label: "Speaking", href: "/speaking" },
	{ label: "Contact", href: "/contact" },
];

const desktopNavItems = navItems.filter((item) => item.href !== "/contact");

const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
const activePath = normalizePath(currentPath);
const isActive = (href: string) => {
	if (href === "/services") return activePath === "/services" || activePath.startsWith("/services/");
	if (href === "/programs") return activePath === "/programs" || activePath.startsWith("/programs/");
	if (href === "/resources") return activePath === "/resources" || activePath.startsWith("/resources/") || activePath === "/insights";
	return activePath === href;
};
---

<header class="site-header" aria-label="Primary navigation">
	<div class="container header-inner">
		<a class="brand" href="/" aria-label="Dr. Lisa Koche home">
			<BrandLogo size="md" showTagline={true} loading="eager" />
		</a>
		<div class="desktop-nav-suite">
			<nav class="nav-links nav-desktop" aria-label="Main menu">
				{
					desktopNavItems.map((item) => (
						<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>
			<a class="button button-primary header-cta desktop-cta" href="/contact" aria-current={isActive("/contact") ? "page" : undefined}>Book</a>
		</div>
		<details class="mobile-menu">
			<summary aria-label="Open navigation menu">
				<span>Menu</span>
			</summary>
			<div class="mobile-panel">
				<nav class="nav-links nav-mobile" aria-label="Mobile menu">
					{
						navItems.map((item) => (
							<a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
								{item.label}
							</a>
						))
					}
				</nav>
				<a class="button button-primary header-cta mobile-cta" href="/contact">Book Discovery</a>
			</div>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding-block: clamp(0.45rem, 1.4vw, 0.72rem);
		background: linear-gradient(180deg, rgba(245, 247, 251, 0.9), rgba(245, 247, 251, 0));
		pointer-events: none;
	}

	.header-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(0.55rem, 1.4vw, 1rem);
		align-items: center;
		padding: 0.48rem;
		border: 1px solid rgba(40, 156, 176, 0.16);
		border-radius: var(--radius-pill);
		background:
			linear-gradient(115deg, rgba(255, 255, 255, 0.88), rgba(248, 254, 255, 0.7)),
			rgba(255, 255, 255, 0.58);
		box-shadow: 0 18px 50px rgba(31, 62, 74, 0.08);
		backdrop-filter: blur(24px);
		pointer-events: auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		padding-inline: 0.42rem 0.2rem;
		width: fit-content;
		max-width: min(18rem, 58vw);
	}

	.desktop-nav-suite {
		display: none;
	}

	.nav-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.18rem;
		align-items: center;
		color: rgba(31, 62, 74, 0.68);
		font-size: clamp(0.78rem, 0.22vw + 0.72rem, 0.88rem);
		font-weight: 700;
		letter-spacing: 0;
	}

	.nav-links a {
		border-radius: var(--radius-pill);
		padding: 0.58rem 0.72rem;
		line-height: 1;
		transition:
			background-color var(--transition),
			box-shadow var(--transition),
			color var(--transition),
			transform var(--transition);
	}

	.nav-links a:hover {
		background: rgba(255, 255, 255, 0.72);
		color: var(--color-deep-evergreen);
		box-shadow: inset 0 0 0 1px rgba(40, 156, 176, 0.13);
		transform: translateY(-1px);
	}

	.nav-links a[aria-current="page"] {
		color: var(--color-deep-evergreen);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.68)),
			var(--gradient-spectrum-soft);
		box-shadow:
			inset 0 0 0 1px rgba(40, 156, 176, 0.16),
			0 8px 18px rgba(80, 166, 163, 0.1);
	}

	.header-cta {
		width: fit-content;
		min-height: 2.32rem;
		padding-inline: 0.9rem;
		box-shadow: 0 12px 24px rgba(40, 156, 176, 0.18);
	}

	.mobile-menu {
		position: relative;
	}

	.mobile-menu summary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.58rem 1rem;
		border: 1px solid rgba(40, 156, 176, 0.2);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.78);
		color: var(--color-deep-evergreen);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.55);
		list-style: none;
		cursor: pointer;
		user-select: none;
	}

	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu[open] summary {
		border-color: rgba(216, 76, 159, 0.34);
	}

	.mobile-panel {
		position: absolute;
		right: 0;
		z-index: 30;
		width: min(19rem, calc(100vw - (var(--gutter) * 2)));
		padding: var(--space-md);
		margin-top: 0.55rem;
		border: 1px solid rgba(40, 156, 176, 0.24);
		border-radius: 1.35rem;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(248, 254, 255, 0.93)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-soft);
	}

	.nav-mobile {
		display: grid;
		gap: 0.2rem;
		font-size: 0.84rem;
		letter-spacing: 0;
	}

	.nav-mobile a {
		padding: 0.64rem 0.72rem;
	}

	.mobile-cta {
		width: 100%;
		margin-top: var(--space-sm);
	}

	@media (min-width: 940px) {
		.header-inner {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.desktop-nav-suite {
			display: flex;
			align-items: center;
			justify-self: end;
			gap: 0.28rem;
			width: fit-content;
			padding: 0.2rem;
			border: 1px solid rgba(40, 156, 176, 0.13);
			border-radius: var(--radius-pill);
			background: rgba(255, 255, 255, 0.46);
		}

		.nav-desktop {
			justify-content: center;
		}

		.desktop-cta {
			flex: 0 0 auto;
			min-width: clamp(5.6rem, 7vw, 7.25rem);
		}

		.mobile-menu {
			display: none;
		}
	}

	@media (max-width: 1080px) and (min-width: 940px) {
		.header-inner {
			gap: 0.55rem;
		}

		.brand {
			max-width: 13.2rem;
		}

		.nav-links a {
			padding-inline: 0.48rem;
		}

		.header-cta {
			min-height: 2.2rem;
			padding-inline: 0.72rem;
		}

		.desktop-cta {
			min-width: 4.8rem;
		}
	}

	@media (max-width: 939px) {
		.desktop-nav-suite,
		.desktop-cta {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.brand {
			max-width: min(14rem, 54vw);
		}
	}
</style>
