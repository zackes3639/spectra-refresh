---
import { isExternalUrl } from "../data/site";

interface Props {
	title: string;
	copy: string;
	href?: string;
	label?: string;
}

const { title, copy, href = "/contact", label = "Start here" } = Astro.props;
const linkAttrs = isExternalUrl(href) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<article class="card contact-card">
	<h3>{title}</h3>
	<p>{copy}</p>
	<a href={href} {...linkAttrs}>{label}</a>
</article>

<style>
	.contact-card {
		display: grid;
		min-height: 15rem;
		align-content: start;
		padding: clamp(1.25rem, 3vw, 1.85rem);
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2vw, 1.9rem);
		font-weight: 400;
		line-height: 1.12;
	}

	p {
		margin: var(--space-md) 0 var(--space-xl);
		color: var(--color-muted);
	}

	a {
		margin-top: auto;
		color: var(--color-spectra-teal);
		font-size: 0.88rem;
		font-weight: 800;
	}
</style>
