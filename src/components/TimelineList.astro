---
import { widont } from "../utils/typography";

interface TimelineItem {
	title: string;
	copy: string;
	marker?: string;
}

interface Props {
	items: TimelineItem[];
	ariaLabel: string;
}

const { items, ariaLabel } = Astro.props;
---

<ol class="timeline-list" aria-label={ariaLabel}>
	{
		items.map((item, index) => (
			<li>
				<span aria-hidden="true">{item.marker ?? String(index + 1).padStart(2, "0")}</span>
				<div>
					<h3 set:html={widont(item.title)} />
					<p set:html={widont(item.copy)} />
				</div>
			</li>
		))
	}
</ol>

<style>
	.timeline-list {
		display: grid;
		gap: 0;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--color-border);
		list-style: none;
	}

	li {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: clamp(var(--space-16), 2.5vw, var(--space-24));
		align-items: start;
		padding: clamp(var(--space-16), 2.5vw, var(--space-24)) 0;
		border-bottom: 1px solid var(--color-border);
	}

	li > span {
		display: inline-grid;
		min-width: 2.35rem;
		height: 2.35rem;
		place-items: center;
		border: 1px solid rgba(40, 156, 176, 0.22);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.66);
		color: var(--color-spectra-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.3rem, 2vw, 1.8rem);
		font-weight: 400;
		line-height: 1.16;
	}

	p {
		margin: var(--space-8) 0 0;
		color: var(--color-muted);
		line-height: 1.5;
	}
</style>
