---
import { isExternalUrl } from "../data/site";
import { widont } from "../utils/typography";

interface Props {
	title: string;
	titleLines?: string[];
	copy: string;
	copyHtml?: string;
	primaryHref?: string;
	primaryLabel?: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	mediaLabel?: string;
	imageSrc?: string;
	imageAlt?: string;
	mediaType?: "portrait" | "stage" | "abstract" | "process";
	hideMedia?: boolean;
	variant?: "standard" | "home" | "story";
	imagePosition?: string;
	mobileImagePosition?: string;
	imageScale?: string;
	mobileImageScale?: string;
}

const {
	title,
	titleLines,
	copy,
	copyHtml,
	primaryHref,
	primaryLabel,
	secondaryHref,
	secondaryLabel,
	mediaLabel = "Brand imagery",
	imageSrc,
	imageAlt = mediaLabel,
	mediaType = "abstract",
	hideMedia = false,
	variant = "standard",
	imagePosition,
	mobileImagePosition,
	imageScale,
	mobileImageScale,
} = Astro.props;

const primaryAttrs = primaryHref && isExternalUrl(primaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
const secondaryAttrs = secondaryHref && isExternalUrl(secondaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
const mediaStyle = [
	imagePosition && `--hero-image-position: ${imagePosition}`,
	mobileImagePosition && `--hero-image-mobile-position: ${mobileImagePosition}`,
	imageScale && `--hero-image-scale: ${imageScale}`,
	mobileImageScale && `--hero-image-mobile-scale: ${mobileImageScale}`,
]
	.filter(Boolean)
	.join("; ");
---

<section class:list={["page-hero", `media-${mediaType}`, `variant-${variant}`, hideMedia && "hide-media"]} aria-labelledby="page-hero-title">
	<div class="container page-hero-grid">
		<div class="page-hero-copy">
			<h1 aria-label={titleLines ? titleLines.join(" ") : undefined} class:list={[titleLines && "stacked-title"]} id="page-hero-title">
				{
					titleLines
						? titleLines.map((line) => <span set:html={widont(line)} />)
						: <Fragment set:html={widont(title)} />
				}
			</h1>
			<p set:html={copyHtml ?? widont(copy)} />
			{
				(primaryHref || secondaryHref) && (
					<div class="page-hero-actions">
						{primaryHref && primaryLabel && <a class="button button-primary" href={primaryHref} {...primaryAttrs}>{primaryLabel}</a>}
						{secondaryHref && secondaryLabel && <a class="button button-secondary" href={secondaryHref} {...secondaryAttrs}>{secondaryLabel}</a>}
					</div>
				)
			}
		</div>
		{
			!hideMedia && (
				<aside class="page-hero-media" aria-label={mediaLabel} style={mediaStyle}>
					{
						imageSrc ? (
							<div class="hero-photo-stage">
								<img class="hero-image-backdrop" src={imageSrc} alt="" aria-hidden="true" loading="eager" decoding="async" />
								<img class="hero-image" src={imageSrc} alt={imageAlt} loading="eager" decoding="async" />
							</div>
						) : mediaType === "process" ? (
							<div class="process-art" aria-hidden="true">
								<svg class="clinical-compass" viewBox="0 0 420 420" role="img">
									<circle class="compass-ring compass-ring-outer" cx="210" cy="210" r="152" />
									<circle class="compass-ring compass-ring-inner" cx="210" cy="210" r="82" />
									<path class="compass-axis" d="M210 54v312" />
									<path class="compass-axis" d="M54 210h312" />
									<path class="compass-arc compass-arc-listen" d="M73 210a137 137 0 0 1 68-119" />
									<path class="compass-arc compass-arc-map" d="M151 85a137 137 0 0 1 137 0" />
									<path class="compass-arc compass-arc-translate" d="M307 95a137 137 0 0 1 38 148" />
									<path class="compass-arc compass-arc-choose" d="M324 274a137 137 0 0 1-126 72" />
									<path class="compass-arc compass-arc-refine" d="M170 341a137 137 0 0 1-94-94" />
								</svg>
								<div class="process-core">
									<span class="reader-mark">the person</span>
									<span class="reader-context">body + story</span>
								</div>
								<ol class="compass-annotations">
									<li class="compass-note compass-note-listen">
										<span class="note-index">01</span>
										<span class="note-body">
											<strong>listen</strong>
											<em>whole story</em>
										</span>
									</li>
									<li class="compass-note compass-note-map">
										<span class="note-index">02</span>
										<span class="note-body">
											<strong>map</strong>
											<em>body signals</em>
										</span>
									</li>
									<li class="compass-note compass-note-translate">
										<span class="note-index">03</span>
										<span class="note-body">
											<strong>translate</strong>
											<em>plain language</em>
										</span>
									</li>
									<li class="compass-note compass-note-choose">
										<span class="note-index">04</span>
										<span class="note-body">
											<strong>choose</strong>
											<em>agency</em>
										</span>
									</li>
									<li class="compass-note compass-note-refine">
										<span class="note-index">05</span>
										<span class="note-body">
											<strong>refine</strong>
											<em>trust</em>
										</span>
									</li>
								</ol>
							</div>
						) : (
							<>
								<!-- Replace this placeholder with final approved brand photography or page-specific imagery. -->
								<div class="media-art" aria-hidden="true">
									<span></span>
								</div>
							</>
						)
					}
				</aside>
			)
		}
	</div>
</section>

<style>
	.page-hero {
		padding: clamp(var(--space-40), 5vw, var(--space-64)) 0 var(--space-24);
	}

	.page-hero-grid {
		display: grid;
		gap: clamp(var(--space-40), 7vw, var(--space-80));
		align-items: center;
	}

	.page-hero-copy {
		max-width: 52rem;
	}

	.hide-media {
		padding-bottom: clamp(var(--space-32), 4vw, var(--space-56));
	}

	.hide-media .page-hero-grid {
		grid-template-columns: minmax(0, 1fr);
	}

	.hide-media .page-hero-copy {
		max-width: min(58rem, var(--max-text-width));
	}

	.variant-home {
		padding-top: clamp(var(--space-32), 4vw, var(--space-56));
	}

	.variant-home .page-hero-grid {
		gap: clamp(var(--space-32), 6vw, var(--space-80));
	}

	.variant-home .page-hero-copy {
		max-width: 45rem;
	}

	.variant-home h1 {
		max-width: min(100%, 14ch);
		font-size: clamp(2.85rem, 5vw, 4.85rem);
		line-height: 1.02;
	}

	.variant-home .page-hero-copy p {
		max-width: 35rem;
	}

	.variant-story .page-hero-grid {
		align-items: center;
	}

	.variant-story h1 {
		max-width: 100%;
		white-space: nowrap;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.45rem, 5.5vw, 5.2rem);
		font-weight: 420;
		letter-spacing: 0;
		line-height: 1.02;
	}

	.stacked-title {
		font-size: clamp(2.9rem, 7.5vw, 6.5rem);
		line-height: 0.96;
		letter-spacing: 0;
	}

	.stacked-title span {
		display: block;
	}

	.stacked-title span:nth-child(1) {
		color: var(--color-deep-evergreen);
	}

	.stacked-title span:nth-child(2) {
		color: var(--color-spectra-teal);
	}

	.stacked-title span:nth-child(3) {
		color: var(--color-spectra-violet);
	}

	.stacked-title span:nth-child(4) {
		color: var(--color-longevity-gold);
	}

	.variant-home .stacked-title span:first-child {
		font-size: clamp(3.05rem, 5vw, 4.85rem);
	}

	.variant-home .stacked-title span:nth-child(n + 2) {
		font-size: clamp(2.05rem, 3.4vw, 3.3rem);
		line-height: 0.96;
	}

	.page-hero-copy p {
		max-width: min(42rem, var(--max-text-width));
		margin: var(--space-24) 0 0;
		color: var(--color-muted);
		font-size: clamp(1rem, 1.25vw, 1.16rem);
		line-height: 1.62;
	}

	.page-hero-copy strong {
		color: var(--color-spectra-pink);
		font-weight: 800;
	}

	.page-hero-copy :global(.hero-emphasis) {
		color: var(--color-spectra-pink) !important;
		font-weight: 800;
	}

	.page-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-32);
	}

	.page-hero-media {
		position: relative;
		display: grid;
		min-height: clamp(22rem, 40vw, 32rem);
		place-items: center;
		overflow: hidden;
		border: 1px solid rgba(40, 156, 176, 0.24);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.88), rgba(215, 239, 244, 0.58)),
			radial-gradient(circle at 76% 18%, rgba(226, 96, 151, 0.15), transparent 14rem),
			radial-gradient(circle at 18% 82%, rgba(40, 156, 176, 0.24), transparent 13rem),
			radial-gradient(circle at 42% 18%, rgba(243, 204, 114, 0.17), transparent 12rem);
		box-shadow: var(--shadow-spectrum);
	}

	.page-hero-media::before {
		position: absolute;
		inset: 0 0 auto;
		z-index: 1;
		height: 0.34rem;
		background: var(--gradient-spectrum);
		content: "";
	}

	.hero-image {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--hero-image-position, 74% 30%);
		transform: scale(var(--hero-image-scale, 1.12));
	}

	.hero-photo-stage {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(247, 248, 245, 0.58)),
			radial-gradient(circle at 16% 18%, rgba(244, 201, 93, 0.14), transparent 12rem),
			radial-gradient(circle at 86% 82%, rgba(216, 76, 159, 0.12), transparent 14rem);
	}

	.hero-photo-stage::after {
		position: absolute;
		inset: 0;
		z-index: 2;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.14), transparent 32%),
			linear-gradient(90deg, rgba(247, 248, 245, 0.2), transparent 34%, rgba(30, 36, 33, 0.08));
		content: "";
		pointer-events: none;
	}

	.hero-image-backdrop {
		position: absolute;
		inset: 1.1rem;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--hero-image-position, 74% 30%);
		filter: blur(18px) saturate(0.9);
		opacity: 0.22;
		transform: scale(var(--hero-backdrop-scale, 1.08));
	}

	.media-stage .page-hero-media {
		background:
			var(--gradient-evergreen-spectrum),
			radial-gradient(circle at 80% 15%, rgba(244, 201, 93, 0.24), transparent 14rem);
	}

	.media-portrait .hero-image,
	.media-portrait .hero-image-backdrop {
		object-position: var(--hero-image-position, 50% 30%);
	}

	.media-process .page-hero-media {
		min-height: clamp(24rem, 36vw, 33rem);
		background:
			radial-gradient(circle at 24% 24%, rgba(243, 204, 114, 0.14), transparent 10rem),
			radial-gradient(circle at 78% 32%, rgba(122, 117, 207, 0.13), transparent 13rem),
			radial-gradient(circle at 62% 82%, rgba(40, 156, 176, 0.16), transparent 12rem),
			linear-gradient(150deg, rgba(255, 255, 255, 0.94), rgba(215, 239, 244, 0.5));
	}

	:global(.process-art) {
		position: relative;
		width: min(88%, 28rem);
		aspect-ratio: 1;
		background:
			radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.52), transparent 23%),
			radial-gradient(circle at 50% 50%, rgba(215, 239, 244, 0.24), transparent 62%);
	}

	:global(.process-art)::before {
		position: absolute;
		inset: 15%;
		border: 1px solid rgba(40, 156, 176, 0.08);
		border-radius: 50%;
		box-shadow:
			0 0 0 3.8rem rgba(255, 255, 255, 0.11),
			0 0 0 6.6rem rgba(122, 117, 207, 0.025);
		content: "";
	}

	:global(.clinical-compass) {
		position: absolute;
		inset: 2%;
		z-index: 1;
		width: 96%;
		height: 96%;
		overflow: visible;
	}

	:global(.compass-ring),
	:global(.compass-axis),
	:global(.compass-arc) {
		fill: none;
		vector-effect: non-scaling-stroke;
	}

	:global(.compass-ring) {
		stroke: rgba(31, 62, 74, 0.11);
		stroke-width: 1;
	}

	:global(.compass-ring-inner) {
		stroke: rgba(222, 184, 94, 0.17);
	}

	:global(.compass-axis) {
		stroke: rgba(31, 62, 74, 0.09);
		stroke-width: 1;
	}

	:global(.compass-arc) {
		stroke-width: 2.5;
		stroke-linecap: round;
		opacity: 0.5;
	}

	:global(.compass-arc-listen) {
		stroke: var(--color-spectra-teal);
	}

	:global(.compass-arc-map) {
		stroke: var(--color-spectra-violet);
	}

	:global(.compass-arc-translate) {
		stroke: var(--color-spectra-magenta);
	}

	:global(.compass-arc-choose) {
		stroke: var(--color-longevity-gold);
	}

	:global(.compass-arc-refine) {
		stroke: var(--color-spectra-mint);
	}

	:global(.process-core) {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 4;
		display: grid;
		place-items: center;
		align-content: center;
		gap: var(--space-4);
		width: 7.4rem;
		text-align: center;
		transform: translate(-50%, -50%);
	}

	:global(.process-core)::after {
		position: absolute;
		content: "";
	}

	:global(.process-core)::after {
		left: 50%;
		top: 50%;
		z-index: -1;
		width: clamp(5.4rem, 10.5vw, 6.45rem);
		aspect-ratio: 1;
		border: 1px solid rgba(40, 156, 176, 0.2);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.58);
		box-shadow:
			0 0 0 1.15rem rgba(255, 255, 255, 0.14),
			0 18px 38px rgba(80, 166, 163, 0.1);
		transform: translate(-50%, -50%);
	}

	:global(.process-core span) {
		color: rgba(31, 62, 74, 0.62);
		font-weight: 850;
		line-height: 1;
		text-transform: uppercase;
	}

	:global(.process-core .reader-mark) {
		color: var(--color-deep-evergreen);
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 2vw, 1.42rem);
		font-weight: 430;
		letter-spacing: 0;
		text-transform: lowercase;
		white-space: nowrap;
	}

	:global(.process-core .reader-context) {
		color: rgba(31, 62, 74, 0.56);
		font-size: 0.52rem;
		letter-spacing: 0.12em;
	}

	:global(.compass-annotations) {
		position: absolute;
		inset: 0;
		z-index: 3;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	:global(.compass-note) {
		position: absolute;
		display: flex;
		width: 8.2rem;
		align-items: flex-start;
		gap: var(--space-8);
		padding: 0;
		background: transparent;
		transform: translateY(-50%);
	}

	:global(.compass-note)::before {
		position: absolute;
		top: 50%;
		width: 1.85rem;
		height: 1px;
		background: currentColor;
		opacity: 0.3;
		content: "";
		transform: translateY(-50%);
	}

	:global(.compass-note-listen) {
		top: 31%;
		left: 6%;
		color: var(--color-spectra-teal);
	}

	:global(.compass-note-map) {
		top: 14%;
		left: 58%;
		color: var(--color-spectra-violet);
	}

	:global(.compass-note-translate) {
		top: 48%;
		left: 69%;
		width: 7.45rem;
		color: var(--color-spectra-magenta);
	}

	:global(.compass-note-choose) {
		top: 80%;
		left: 58%;
		color: var(--color-longevity-gold);
	}

	:global(.compass-note-refine) {
		top: 70%;
		left: 6%;
		color: var(--color-spectra-mint);
	}

	:global(.compass-note-listen)::before,
	:global(.compass-note-refine)::before {
		left: calc(100% + var(--space-8));
	}

	:global(.compass-note-map)::before,
	:global(.compass-note-translate)::before,
	:global(.compass-note-choose)::before {
		left: calc(-1.85rem - var(--space-8));
	}

	:global(.note-index) {
		display: inline-grid;
		width: 1.65rem;
		height: 1.28rem;
		flex: 0 0 auto;
		margin-top: 0.02rem;
		place-items: center;
		border: 1px solid rgba(40, 156, 176, 0.18);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.62);
		color: currentColor;
		font-size: 0.55rem;
		font-variant-numeric: tabular-nums;
		font-weight: 850;
		letter-spacing: 0.06em;
		line-height: 1;
	}

	:global(.note-body) {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	:global(.note-body strong) {
		display: block;
		color: rgba(31, 62, 74, 0.78);
		font-size: clamp(0.58rem, 0.7vw, 0.66rem);
		font-weight: 850;
		letter-spacing: 0.075em;
		line-height: 1.18;
		text-transform: uppercase;
		white-space: nowrap;
	}

	:global(.note-body em) {
		display: block;
		color: rgba(31, 62, 74, 0.52);
		font-size: clamp(0.52rem, 0.63vw, 0.58rem);
		font-style: normal;
		font-weight: 760;
		letter-spacing: 0.055em;
		line-height: 1.2;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.media-art {
		display: grid;
		width: min(62%, 19rem);
		aspect-ratio: 0.78;
		place-items: center;
		border: 1px solid rgba(80, 166, 163, 0.2);
		border-radius: 48% 48% 42% 42%;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(80, 166, 163, 0.18)),
			radial-gradient(circle at 52% 25%, rgba(244, 201, 93, 0.38), transparent 6rem),
			radial-gradient(circle at 78% 68%, rgba(216, 76, 159, 0.18), transparent 5rem);
	}

	.media-stage .media-art {
		border-color: rgba(247, 248, 245, 0.22);
		background:
			linear-gradient(180deg, rgba(247, 248, 245, 0.22), rgba(80, 166, 163, 0.2)),
			radial-gradient(circle at 50% 22%, rgba(244, 201, 93, 0.28), transparent 7rem),
			radial-gradient(circle at 75% 72%, rgba(216, 76, 159, 0.18), transparent 6rem);
	}

	.media-art span {
		width: 46%;
		aspect-ratio: 1;
		border: 1px solid rgba(49, 70, 58, 0.18);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.34);
	}

	.page-hero-media .placeholder-note {
		position: absolute;
		right: var(--space-lg);
		bottom: var(--space-lg);
		left: var(--space-lg);
		margin: 0;
		text-align: center;
	}

	.media-stage .placeholder-note {
		color: rgba(247, 248, 245, 0.64);
	}

	@media (min-width: 900px) {
		.page-hero-grid {
			grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.72fr);
		}
	}

	@media (min-width: 761px) {
		.stacked-title span {
			white-space: nowrap;
		}
	}

	@media (min-width: 761px) and (max-width: 899px) {
		.variant-home {
			padding-bottom: var(--space-48);
		}

		.variant-home .page-hero-grid {
			gap: var(--space-32);
		}

		.variant-home .page-hero-media {
			width: 100%;
			max-width: 40rem;
			min-height: 24rem;
			aspect-ratio: 16 / 9;
			margin-inline: auto;
		}
	}

	@media (max-width: 760px) {
		.page-hero {
			padding: clamp(var(--space-24), 6vw, var(--space-40)) 0 var(--space-16);
		}

		.variant-home h1 {
			font-size: clamp(2.55rem, 11vw, 3.35rem);
			line-height: 1.02;
		}

		.variant-home .stacked-title span:first-child {
			font-size: clamp(2.55rem, 11vw, 3.35rem);
		}

		.variant-home .stacked-title span:nth-child(n + 2) {
			font-size: clamp(1.85rem, 7.8vw, 2.45rem);
			line-height: 0.98;
		}

		.stacked-title {
			font-size: clamp(2.45rem, 11.5vw, 3.5rem);
			line-height: 1;
		}

		.page-hero-copy p {
			font-size: 1.05rem;
			line-height: 1.62;
		}

		.page-hero-media {
			min-height: clamp(18rem, 72vw, 24rem);
		}

		.media-process .page-hero-media {
			min-height: clamp(24rem, 92vw, 28rem);
		}

		:global(.process-art) {
			width: min(94%, 24rem);
		}

		:global(.process-core) {
			width: 6.9rem;
		}

		:global(.process-core .reader-mark) {
			font-size: 1.05rem;
		}

		:global(.compass-note) {
			width: 7.9rem;
			gap: var(--space-4);
		}

		:global(.note-index) {
			width: 1.45rem;
			height: 1.18rem;
