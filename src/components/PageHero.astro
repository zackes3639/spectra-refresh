---
import { isExternalUrl } from "../data/site";

interface Props {
	title: string;
	titleLines?: string[];
	copy: string;
	copyHtml?: string;
	primaryHref?: string;
	primaryLabel?: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	mediaLabel?: string;
	imageSrc?: string;
	imageAlt?: string;
	mediaType?: "portrait" | "stage" | "abstract";
}

const {
	title,
	titleLines,
	copy,
	copyHtml,
	primaryHref,
	primaryLabel,
	secondaryHref,
	secondaryLabel,
	mediaLabel = "Brand imagery",
	imageSrc,
	imageAlt = mediaLabel,
	mediaType = "abstract",
} = Astro.props;

const primaryAttrs = primaryHref && isExternalUrl(primaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
const secondaryAttrs = secondaryHref && isExternalUrl(secondaryHref) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<section class={`page-hero media-${mediaType}`} aria-labelledby="page-hero-title">
	<div class="container page-hero-grid">
		<div class="page-hero-copy">
			<h1 class:list={[titleLines && "stacked-title"]} id="page-hero-title">
				{
					titleLines
						? titleLines.map((line) => <span>{line}</span>)
						: title
				}
			</h1>
			<p>{copyHtml ? <Fragment set:html={copyHtml} /> : copy}</p>
			{
				(primaryHref || secondaryHref) && (
					<div class="page-hero-actions">
						{primaryHref && primaryLabel && <a class="button button-primary" href={primaryHref} {...primaryAttrs}>{primaryLabel}</a>}
						{secondaryHref && secondaryLabel && <a class="button button-secondary" href={secondaryHref} {...secondaryAttrs}>{secondaryLabel}</a>}
					</div>
				)
			}
		</div>
		<aside class="page-hero-media" aria-label={mediaLabel}>
			{
				imageSrc ? (
					<div class="hero-photo-stage">
						<img class="hero-image-backdrop" src={imageSrc} alt="" aria-hidden="true" loading="eager" decoding="async" />
						<img class="hero-image" src={imageSrc} alt={imageAlt} loading="eager" decoding="async" />
					</div>
				) : (
					<>
						<!-- Replace this placeholder with final approved brand photography or page-specific imagery. -->
						<div class="media-art" aria-hidden="true">
							<span></span>
						</div>
					</>
				)
			}
		</aside>
	</div>
</section>

<style>
	.page-hero {
		padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(1.15rem, 2.4vw, 2rem);
	}

	.page-hero-grid {
		display: grid;
		gap: clamp(2.5rem, 7vw, 5.5rem);
		align-items: center;
	}

	.page-hero-copy {
		max-width: 52rem;
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.45rem, 5.7vw, 5.4rem);
		font-weight: 420;
		letter-spacing: -0.01em;
		line-height: 0.96;
	}

	.stacked-title {
		font-size: clamp(2.9rem, 8vw, 7rem);
		line-height: 0.9;
		letter-spacing: -0.014em;
	}

	.stacked-title span {
		display: block;
	}

	.stacked-title span:nth-child(1) {
		color: var(--color-deep-evergreen);
	}

	.stacked-title span:nth-child(2) {
		color: var(--color-spectra-teal);
	}

	.stacked-title span:nth-child(3) {
		color: var(--color-spectra-pink);
	}

	.page-hero-copy p {
		max-width: 42rem;
		margin: var(--space-lg) 0 0;
		color: var(--color-muted);
		font-size: clamp(1rem, 1.25vw, 1.16rem);
		line-height: 1.7;
	}

	.page-hero-copy strong {
		color: var(--color-spectra-pink);
		font-weight: 800;
	}

	.page-hero-copy :global(.hero-emphasis) {
		color: var(--color-spectra-pink) !important;
		font-weight: 800;
	}

	.page-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
	}

	.page-hero-media {
		position: relative;
		display: grid;
		min-height: clamp(24rem, 45vw, 36rem);
		place-items: center;
		overflow: hidden;
		border: 1px solid rgba(40, 156, 176, 0.24);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.88), rgba(215, 239, 244, 0.58)),
			radial-gradient(circle at 76% 18%, rgba(226, 96, 151, 0.15), transparent 14rem),
			radial-gradient(circle at 18% 82%, rgba(40, 156, 176, 0.24), transparent 13rem),
			radial-gradient(circle at 42% 18%, rgba(243, 204, 114, 0.17), transparent 12rem);
		box-shadow: var(--shadow-spectrum);
	}

	.page-hero-media::before {
		position: absolute;
		inset: 0 0 auto;
		z-index: 1;
		height: 0.34rem;
		background: var(--gradient-spectrum);
		content: "";
	}

	.hero-image {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 74% 30%;
		transform: scale(1.12);
	}

	.hero-photo-stage {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(247, 248, 245, 0.58)),
			radial-gradient(circle at 16% 18%, rgba(244, 201, 93, 0.14), transparent 12rem),
			radial-gradient(circle at 86% 82%, rgba(216, 76, 159, 0.12), transparent 14rem);
	}

	.hero-photo-stage::after {
		position: absolute;
		inset: 0;
		z-index: 2;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.14), transparent 32%),
			linear-gradient(90deg, rgba(247, 248, 245, 0.2), transparent 34%, rgba(30, 36, 33, 0.08));
		content: "";
		pointer-events: none;
	}

	.hero-image-backdrop {
		position: absolute;
		inset: 1.1rem;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 74% 30%;
		filter: blur(18px) saturate(0.9);
		opacity: 0.22;
		transform: scale(1.08);
	}

	.media-stage .page-hero-media {
		background:
			var(--gradient-evergreen-spectrum),
			radial-gradient(circle at 80% 15%, rgba(244, 201, 93, 0.24), transparent 14rem);
	}

	.media-art {
		display: grid;
		width: min(62%, 19rem);
		aspect-ratio: 0.78;
		place-items: center;
		border: 1px solid rgba(80, 166, 163, 0.2);
		border-radius: 48% 48% 42% 42%;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(80, 166, 163, 0.18)),
			radial-gradient(circle at 52% 25%, rgba(244, 201, 93, 0.38), transparent 6rem),
			radial-gradient(circle at 78% 68%, rgba(216, 76, 159, 0.18), transparent 5rem);
	}

	.media-stage .media-art {
		border-color: rgba(247, 248, 245, 0.22);
		background:
			linear-gradient(180deg, rgba(247, 248, 245, 0.22), rgba(80, 166, 163, 0.2)),
			radial-gradient(circle at 50% 22%, rgba(244, 201, 93, 0.28), transparent 7rem),
			radial-gradient(circle at 75% 72%, rgba(216, 76, 159, 0.18), transparent 6rem);
	}

	.media-art span {
		width: 46%;
		aspect-ratio: 1;
		border: 1px solid rgba(49, 70, 58, 0.18);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.34);
	}

	.page-hero-media .placeholder-note {
		position: absolute;
		right: var(--space-lg);
		bottom: var(--space-lg);
		left: var(--space-lg);
		margin: 0;
		text-align: center;
	}

	.media-stage .placeholder-note {
		color: rgba(247, 248, 245, 0.64);
	}

	@media (min-width: 900px) {
		.page-hero-grid {
			grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.72fr);
		}
	}

	@media (max-width: 760px) {
		.page-hero {
			padding: clamp(1.9rem, 5.5vw, 2.6rem) 0 clamp(0.85rem, 4vw, 1.4rem);
		}

		.stacked-title {
			font-size: clamp(2.45rem, 11.5vw, 3.5rem);
			line-height: 0.92;
		}

		.page-hero-copy p {
			font-size: 1.05rem;
			line-height: 1.62;
		}

		.page-hero-media {
			min-height: clamp(18rem, 72vw, 24rem);
		}

		.hero-image {
			object-position: 100% 30%;
			transform: scale(1.18);
		}

		.hero-image-backdrop {
			object-position: 100% 30%;
		}

		.page-hero-actions .button {
			flex: 1 1 100%;
		}
	}
 </style>
