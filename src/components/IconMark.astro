---
export type IconMarkName = "story" | "invite" | "learn" | "spectra" | "context" | "clarity" | "agency" | "stethoscope" | "building" | "graduation" | "microphone";

interface Props {
	name: IconMarkName;
	label?: string;
}

const { name, label } = Astro.props;
const ariaAttrs = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<span class="icon-mark" data-icon={name} {...ariaAttrs}>
	<svg viewBox="0 0 24 24" focusable="false">
		{
			name === "story" && (
				<>
					<path class="icon-line" d="M7.5 6.8v10.4" />
					<path class="icon-line" d="M10.2 8h6.3" />
					<path class="icon-line" d="M10.2 12h7" />
					<path class="icon-line" d="M10.2 16h4.8" />
				</>
			)
		}
		{
			name === "invite" && (
				<>
					<path class="icon-line" d="M7.4 8.2h9.2a2 2 0 0 1 2 2v3.8a2 2 0 0 1-2 2h-3.4L10 18.4V16H7.4a2 2 0 0 1-2-2v-3.8a2 2 0 0 1 2-2Z" />
					<path class="icon-line" d="M9 11.2h6" />
					<path class="icon-line" d="M9 13.6h3.8" />
				</>
			)
		}
		{
			name === "learn" && (
				<>
					<circle class="icon-line" cx="12" cy="12" r="6.25" />
					<path class="icon-line" d="m10.3 14 1.1-3.4 3.3-1.1-1.1 3.4Z" />
				</>
			)
		}
		{
			name === "spectra" && (
				<>
					<circle class="icon-dot dot-a" cx="9" cy="9" r="1.55" />
					<circle class="icon-dot dot-b" cx="15" cy="9" r="1.55" />
					<circle class="icon-dot dot-c" cx="9" cy="15" r="1.55" />
					<circle class="icon-dot dot-d" cx="15" cy="15" r="1.55" />
					<circle class="icon-line" cx="12" cy="12" r="6.25" />
				</>
			)
		}
		{
			name === "context" && (
				<>
					<path class="icon-line" d="M8.2 6.8H6.8v3" />
					<path class="icon-line" d="M15.8 6.8h1.4v3" />
					<path class="icon-line" d="M17.2 14.2v3h-1.4" />
					<path class="icon-line" d="M6.8 14.2v3h1.4" />
					<path class="icon-line" d="M9.4 12h5.2" />
					<circle class="icon-accent-dot" cx="12" cy="12" r="1.25" />
				</>
			)
		}
		{
			name === "clarity" && (
				<>
					<path class="icon-line" d="M7.3 12h9.4" />
					<path class="icon-line" d="M12 7.3v9.4" />
					<circle class="icon-line" cx="12" cy="12" r="3.6" />
					<circle class="icon-accent-dot" cx="12" cy="12" r="1.15" />
				</>
			)
		}
		{
			name === "agency" && (
				<>
					<path class="icon-line" d="M7.2 16.2c2.4-4.4 5.5-7.1 9.6-8.4" />
					<path class="icon-line" d="M13.7 7.2l3.1.6-.8 3" />
					<circle class="icon-accent-dot" cx="7.2" cy="16.2" r="1.2" />
				</>
			)
		}
		{
			name === "stethoscope" && (
				<>
					<path class="icon-line" d="M6.5 5v3.6a3.6 3.6 0 0 0 7.2 0V5" />
					<path class="icon-line" d="M10.1 12.2v2a4 4 0 0 0 8 0v-1.5" />
					<circle class="icon-line" cx="18.1" cy="10.8" r="1.9" />
				</>
			)
		}
		{
			name === "building" && (
				<>
					<path class="icon-line" d="M6.6 18.4V7.3a1 1 0 0 1 1-1h8.8a1 1 0 0 1 1 1v11.1" />
					<path class="icon-line" d="M5.4 18.4h13.2" />
					<path class="icon-line" d="M10.4 18.4v-3.1h3.2v3.1" />
					<path class="icon-line" d="M9.1 9.5h1.8" />
					<path class="icon-line" d="M13.1 9.5h1.8" />
					<path class="icon-line" d="M9.1 12.3h1.8" />
					<path class="icon-line" d="M13.1 12.3h1.8" />
				</>
			)
		}
		{
			name === "graduation" && (
				<>
					<path class="icon-line" d="M4.6 9.5 12 6l7.4 3.5L12 13z" />
					<path class="icon-line" d="M8 11.3v3.3c0 1 1.8 1.9 4 1.9s4-.9 4-1.9v-3.3" />
					<path class="icon-line" d="M19.4 9.7v4.1" />
					<circle class="icon-accent-dot" cx="19.4" cy="14.4" r="0.8" />
				</>
			)
		}
		{
			name === "microphone" && (
				<>
					<rect class="icon-line" x="9.4" y="4.5" width="5.2" height="9" rx="2.6" />
					<path class="icon-line" d="M6.9 11.2a5.1 5.1 0 0 0 10.2 0" />
					<path class="icon-line" d="M12 16.3V19" />
					<path class="icon-line" d="M9.2 19h5.6" />
				</>
			)
		}
	</svg>
</span>

<style>
	.icon-mark {
		--icon-accent: var(--color-deep-evergreen);
		--icon-bg: rgba(255, 255, 255, 0.72);
		position: relative;
		display: inline-grid;
		width: 2.7rem;
		aspect-ratio: 1;
		place-items: center;
		border: 1px solid rgba(40, 156, 176, 0.18);
		border-radius: 50%;
		background:
			radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.96), transparent 31%),
			var(--icon-bg);
		color: var(--icon-accent);
		box-shadow:
			0 0 0 0.28rem rgba(215, 239, 244, 0.2),
			0 10px 20px rgba(80, 166, 163, 0.08);
	}

	.icon-mark[data-icon="spectra"] {
		--icon-accent: var(--color-spectra-teal);
	}

	.icon-mark[data-icon="context"],
	.icon-mark[data-icon="clarity"],
	.icon-mark[data-icon="agency"] {
		border-radius: 0.95rem;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(215, 239, 244, 0.32)),
			var(--icon-bg);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.58),
			0 10px 22px rgba(80, 166, 163, 0.1);
	}

	.icon-mark[data-icon="context"] {
		--icon-accent: var(--color-spectra-teal);
	}

	.icon-mark[data-icon="clarity"] {
		--icon-accent: var(--color-spectra-violet);
	}

	.icon-mark[data-icon="agency"] {
		--icon-accent: var(--color-longevity-gold);
	}

	.icon-mark[data-icon="stethoscope"] {
		--icon-accent: var(--color-spectra-teal);
	}

	.icon-mark[data-icon="building"] {
		--icon-accent: var(--color-spectra-violet);
	}

	.icon-mark[data-icon="graduation"] {
		--icon-accent: var(--color-longevity-gold);
	}

	.icon-mark[data-icon="microphone"] {
		--icon-accent: var(--color-spectra-pink);
	}

	svg {
		width: 1.45rem;
		height: 1.45rem;
		overflow: visible;
	}

	.icon-line {
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.icon-dot {
		stroke: none;
	}

	.icon-accent-dot {
		fill: currentColor;
		stroke: none;
	}

	.dot-a {
		fill: var(--color-spectra-sun);
	}

	.dot-b {
		fill: var(--color-spectra-pink);
	}

	.dot-c {
		fill: var(--color-spectra-teal);
	}

	.dot-d {
		fill: var(--color-spectra-violet);
	}
</style>
