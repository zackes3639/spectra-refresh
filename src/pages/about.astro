---
import CTASection from "../components/CTASection.astro";
import EditorialArtFrame from "../components/EditorialArtFrame.astro";
import Layout from "../components/Layout.astro";
import MetricStrip from "../components/MetricStrip.astro";
import PageHero from "../components/PageHero.astro";
import PathwayCard from "../components/PathwayCard.astro";
import SectionIntro from "../components/SectionIntro.astro";
import TimelineList from "../components/TimelineList.astro";
import type { IconMarkName } from "../components/IconMark.astro";
import { siteLinks } from "../data/site";

const missionParagraphs = [
	"Dr. Lisa Koche built her platform for people who want to understand their bodies, reclaim voice, and make clearer decisions about their health",
	"Her lens blends medical training, root-cause thinking, education, and a spiritually aware understanding of human resilience",
	"This site keeps the spotlight on her story, voice, resources, media, and invitations to speak",
];

const storyTimeline = [
	{
		title: "A personal health story",
		copy: "Her own experience with serious illness shaped deep empathy for people who feel dismissed, confused, or stuck between partial answers",
	},
	{
		title: "Physician and pattern-finder",
		copy: "Her medical background informs the way she notices relationships across body systems, lived experience, and long-term vitality",
	},
	{
		title: "Founder of Spectra Wellness",
		copy: "Spectra Wellness became the organization where her larger vision could take shape",
	},
	{
		title: "Education beyond the office",
		copy: "Through resources, media, and speaking, Dr. Lisa helps people ask better questions and participate more actively in their health",
	},
];

const valueCards = [
	{
		title: "Context",
		copy: "Health questions make more sense when history, biology, lifestyle, environment, and goals are seen together",
	},
	{
		title: "Agency",
		copy: "Education helps people understand options, ask better questions, and advocate with steadier confidence",
	},
	{
		title: "Whole-person lens",
		copy: "The work respects physiology, resilience, spirituality, and real life rather than isolating a single complaint",
	},
];

const professionalBackground = [
	{
		value: "Triple board-certified",
		label: "Physician expertise",
		copy: "Internal medicine, integrative medicine, and pediatrics expertise",
		icon: "stethoscope",
	},
	{
		value: "Founder",
		label: "Spectra Wellness",
		copy: "Created the organization that carries the dedicated practice destination",
		icon: "building",
	},
	{
		value: "Educator",
		label: "Public teaching",
		copy: "Translates root-cause concepts into practical guidance",
		icon: "graduation",
	},
	{
		value: "Speaker",
		label: "Health and leadership audiences",
		copy: "Presents for wellness, media, and leadership communities",
		icon: "microphone",
	},
] satisfies Array<{ value: string; label: string; copy: string; icon: IconMarkName }>;

const nextPaths = [
	{
		title: "Resources",
		copy: "Explore Dr. Lisa's articles, courses, favorites, and education library",
		href: "/resources",
	},
	{
		title: "Speaking",
		copy: "Route podcast, media, event, and stage invitations",
		href: "/speaking",
	},
	{
		title: "Spectra Wellness",
		copy: "For appointments and office information, continue to the Spectra Wellness site",
		href: siteLinks.spectraWellness,
	},
];
---

<Layout
	title="About Dr. Lisa Koche | Founder, Physician, Educator & Speaker"
	description="Meet Dr. Lisa Koche, triple-board-certified physician, founder, speaker, educator, and health literacy advocate"
	currentPath="/about"
>
	<script is:inline>
		// Set the reveal flag before first paint so animated sections start hidden
		// (prevents a flash). The IntersectionObserver is wired up at the end of the page.
		document.documentElement.classList.add("reveal-ready");
	</script>

	<!-- TODO: replace the hero headshot with a retouched portrait that has no legacy Spectra logo.
	     Drop the new file at public/images/dr-lisa-koche-headshot.jpeg, run `npm run optimize:images`,
	     and update imageWidth/imageHeight below if the new dimensions differ. -->
	<PageHero
		title="About Dr Lisa"
		eyebrow="Meet Dr. Lisa"
		copy="Triple board-certified physician, founder, educator, speaker, and advocate helping people understand their bodies with more clarity and context"
		primaryHref="/resources"
		primaryLabel="Explore Resources"
		secondaryHref="/speaking"
		secondaryLabel="Speaking & Media"
		mediaLabel="Dr. Lisa Koche portrait"
		imageSrc="/images/dr-lisa-koche-headshot.jpeg"
		imageAlt="Dr. Lisa Koche portrait"
		imageWidth={2560}
		imageHeight={1280}
		mediaType="portrait"
		variant="story"
		imagePosition="50% 34%"
		mobileImagePosition="50% 30%"
		imageScale="1.08"
		mobileImageScale="1.08"
	/>

	<section class="section" aria-labelledby="mission-title">
		<div class="container editorial-grid mission-grid" data-reveal>
			<div class="copy-stack mission-copy">
				<SectionIntro
					id="mission-title"
					eyebrow="Dr Lisa's Mission"
					title="Body Literacy"
				/>
				<div class="paragraph-stack">
					{missionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>
			<!-- Generated concept art; replace with approved Dr. Lisa brand photography when available. -->
			<EditorialArtFrame src="/images/generated/about-story-still-life.png" width={1402} height={1122} alt="" aspect="wide" />
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="story-title">
		<div class="container story-layout" data-reveal>
			<SectionIntro
				id="story-title"
				eyebrow="Story"
				title="From personal experience to public advocacy"
				copy="Dr. Lisa's story informs a platform built around better questions, deeper context, and a more humane conversation about health"
			/>
			<TimelineList items={storyTimeline} ariaLabel="Dr. Lisa Koche story timeline" />
		</div>
	</section>

	<section class="section" aria-labelledby="values-title">
		<div class="container" data-reveal>
			<SectionIntro
				id="values-title"
				eyebrow="Values"
				title="The principles behind her public voice"
			/>
			<div class="pathway-grid value-grid">
				{valueCards.map((item, index) => (
					<PathwayCard title={item.title} copy={item.copy} index={index + 1} />
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="background-title">
		<div class="container background-layout" data-reveal>
			<SectionIntro
				id="background-title"
				eyebrow="Professional Background"
				title="Medical credentials with real-world leadership"
				copy="A concise view of Dr. Lisa's training, founder role, and public-facing expertise"
			/>
			<MetricStrip items={professionalBackground} ariaLabel="Dr. Lisa professional background" />
		</div>
	</section>

	<section class="section" aria-labelledby="next-title">
		<div class="container" data-reveal>
			<SectionIntro
				id="next-title"
				eyebrow="Next Steps"
				title="Choose the doorway that matches your question"
			/>
			<div class="pathway-grid next-grid">
				{nextPaths.map((item, index) => (
					<PathwayCard
						title={item.title}
						copy={item.copy}
						href={item.href}
						index={index + 1}
						ctaLabel="Continue"
					/>
				))}
			</div>
		</div>
	</section>

	<div data-reveal>
		<CTASection
			eyebrow="Get Started"
			title="Choose your next step"
			copy="Explore Dr. Lisa's resources or invite her to speak"
			compactLayout={true}
			primaryHref="/speaking"
			primaryLabel="Invite Dr. Lisa"
			secondaryHref="/resources"
			secondaryLabel="Explore Resources"
		/>
	</div>
</Layout>

<style>
	.editorial-grid {
		display: grid;
		gap: clamp(var(--space-32), 6vw, var(--space-80));
		align-items: center;
	}

	/* Stacked: section heading above the full-width credential row. */
	.background-layout {
		display: grid;
		gap: clamp(var(--space-32), 4vw, var(--space-48));
	}

	.copy-stack,
	.story-layout {
		display: grid;
		gap: clamp(var(--space-24), 3.5vw, var(--space-40));
	}

	.paragraph-stack {
		display: grid;
		gap: var(--space-md);
		max-width: var(--max-text-width);
	}

	.paragraph-stack p {
		margin: 0;
		color: var(--color-muted);
		font-size: clamp(1rem, 1.15vw, 1.12rem);
		line-height: 1.6;
	}

	.pathway-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-40);
	}

	.story-layout {
		max-width: min(64rem, calc(var(--max-text-width) + 10rem));
		margin-inline: auto;
	}

	@media (min-width: 760px) {
		.value-grid,
		.next-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 900px) {
		.mission-grid {
			grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.72fr);
		}
	}

	/* Scroll-reveal entrance animation. Sections start hidden only once the
	   `reveal-ready` flag is set by JS, so no-JS users always see content. */
	.reveal-ready [data-reveal] {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 600ms ease,
			transform 600ms ease;
		will-change: opacity, transform;
	}

	.reveal-ready [data-reveal].is-visible {
		opacity: 1;
		transform: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-ready [data-reveal] {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}
</style>

<script>
	// Reveal each [data-reveal] block as it scrolls into view. The `reveal-ready`
	// class is set inline in <head>-order above so content starts hidden without a flash;
	// if IntersectionObserver is unavailable we simply show everything.
	const revealEls = document.querySelectorAll("[data-reveal]");

	if (!("IntersectionObserver" in window)) {
		revealEls.forEach((el) => el.classList.add("is-visible"));
	} else {
		const observer = new IntersectionObserver(
			(entries, obs) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						obs.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
		);

		revealEls.forEach((el) => observer.observe(el));
	}
</script>
