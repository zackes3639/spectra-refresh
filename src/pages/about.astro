---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";

const credentials = [
	"Triple board-certified physician",
	"Founder and clinical director",
	"Functional medicine and longevity educator",
	"Speaker for major health and leadership audiences",
];

const pathways = [
	["Become a patient", "/patients", "Understand appointment routing, portal access, and patient logistics."],
	["Explore services", "/services", "See the practice care families and priority service pages."],
	["Learn from Dr. Lisa", "/resources", "Start with free resources, articles, courses, and favorites."],
	["Invite Dr. Lisa", "/speaking", "Route speaking, podcast, and media inquiries."],
];
---

<Layout
	title="About Dr. Lisa Koche | Functional Medicine Physician"
	description="Meet Dr. Lisa Koche, triple-board-certified physician, speaker, educator, and root-cause medicine advocate."
	currentPath="/about"
>
	<PageHero
		title="A physician who understands what it feels like to search for answers."
		copy="Dr. Lisa Koche built her work for people who want to understand their bodies, advocate for themselves, and approach health with science, wisdom, and whole-person care."
		primaryHref="/patients"
		primaryLabel="Become a Patient"
		secondaryHref="/speaking"
		secondaryLabel="Speaking & Media"
		mediaLabel="Dr. Lisa Koche portrait"
		imageSrc="/images/dr-lisa-koche-headshot.jpeg"
		imageAlt="Dr. Lisa Koche portrait"
		mediaType="portrait"
	/>

	<section class="section" aria-labelledby="mission-title">
		<div class="container two-column story-grid">
			<div>
				<p class="eyebrow">Mission</p>
				<h2 id="mission-title">Understand your body. Advocate for yourself. Heal with context.</h2>
			</div>
			<div>
				<p>
					Dr. Lisa's work blends clinical medicine, root-cause investigation, education, and a spiritually
					aware understanding of human resilience. The goal is not to overwhelm patients with more data,
					but to help them ask better questions and make clearer decisions.
				</p>
				<p>
					Her own experience with serious illness shaped her empathy for people who feel dismissed,
					confused, or stuck between conventional answers and a deeper sense that something important is
					being missed.
				</p>
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="story-title">
		<div class="container story-panel">
			<p class="eyebrow">Story</p>
			<h2 id="story-title">From survivor to physician, educator, and patient advocate.</h2>
			<p>
				Dr. Lisa's survivor story, including leukemia and heart failure, informs the practice model she
				has spent decades shaping. Her Tampa clinical practice is one expression of that mission: longer
				listening, deeper diagnostics, proactive strategy, and care that respects the whole person.
			</p>
		</div>
	</section>

	<section class="section" aria-labelledby="credentials-title">
		<div class="container">
			<SectionIntro
				id="credentials-title"
				eyebrow="Credentials"
				title="Authority that stays close to the patient experience."
				copy="Dr. Lisa's public work bridges clinical care, patient education, media, and leadership audiences."
			/>
			<div class="credential-grid">
				{credentials.map((credential) => (
					<article class="card credential-card">
						<span aria-hidden="true"></span>
						<h3>{credential}</h3>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="practice-title">
		<div class="container two-column story-grid">
			<div>
				<p class="eyebrow">Clinical Philosophy</p>
				<h2 id="practice-title">A practice model built for root-cause clarity.</h2>
			</div>
			<div>
				<p>
					Dr. Lisa's clinical ecosystem can include functional medicine, primary care, advanced diagnostics,
					structural support, IV nutrition, performance therapies, aesthetics, and complementary care
					pathways. The throughline is not complexity for its own sake. It is a clearer map of the person
					in front of the team.
				</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="path-title">
		<div class="container">
			<SectionIntro
				id="path-title"
				eyebrow="Pathways"
				title="Choose the doorway that fits this season."
			/>
			<div class="pathway-grid">
				{pathways.map(([title, href, copy]) => (
					<a class="card pathway-card" href={href}>
						<h3>{title}</h3>
						<p>{copy}</p>
					</a>
				))}
			</div>
		</div>
	</section>

	<CTASection
		eyebrow="Next Step"
		title="Start with the path that matches your question."
		copy="Explore patient care, services, education, or speaking inquiries from Dr. Lisa's refreshed home base."
		primaryHref="/services"
		primaryLabel="Explore Services"
		secondaryHref="/contact"
		secondaryLabel="Contact"
	/>
</Layout>

<style>
	.story-grid {
		align-items: start;
	}

	.story-grid h2,
	.story-panel h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.8rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.story-grid p,
	.story-panel p,
	.pathway-card p {
		color: var(--color-muted);
	}

	.story-panel {
		max-width: 62rem;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.8), rgba(220, 239, 238, 0.58)),
			radial-gradient(circle at 85% 16%, rgba(125, 183, 217, 0.22), transparent 16rem),
			radial-gradient(circle at 12% 82%, rgba(216, 76, 159, 0.12), transparent 15rem);
		box-shadow: var(--shadow-spectrum);
	}

	.credential-grid,
	.pathway-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.credential-card,
	.pathway-card {
		display: grid;
		align-content: start;
		min-height: 12rem;
		padding: clamp(1.25rem, 3vw, 1.85rem);
	}

	.credential-card span {
		width: 1rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--gradient-spectrum);
	}

	.credential-card h3,
	.pathway-card h3 {
		margin: var(--space-lg) 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.3vw, 1.95rem);
		font-weight: 400;
		line-height: 1.1;
	}

	.pathway-card h3 {
		margin-top: 0;
	}

	.pathway-card p {
		margin: var(--space-md) 0 0;
	}

	@media (min-width: 760px) {
		.credential-grid,
		.pathway-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
