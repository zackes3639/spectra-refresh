---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";

const milestones = [
	"Triple board-certified physician with a prevention-first clinical orientation.",
	"Founder of Spectra Wellness, a personalized precision longevity practice.",
	"Speaker and educator translating complex physiology for high-performing audiences.",
	"Clinical strategist shaping future-facing longevity care frameworks.",
];
---

<Layout
	title="About Dr. Lisa Koche | Longevity Medicine"
	description="Meet Dr. Lisa Koche, physician authority in longevity medicine and founder of Spectra Wellness."
	currentPath="/about"
>
	<PageHero
		title="A physician voice for modern longevity and intelligent prevention."
		copy="Dr. Lisa Koche combines rigorous clinical medicine, systems-level thinking, and strategic platform vision to help individuals and organizations navigate the future of health."
		primaryHref="/contact"
		primaryLabel="Connect with Dr. Koche"
		secondaryHref="/speaking"
		secondaryLabel="Speaking & Media"
		mediaLabel="Dr. Lisa Koche portrait"
		imageSrc="/images/dr-lisa-koche-headshot.jpeg"
		imageAlt="Dr. Lisa Koche portrait"
		mediaType="portrait"
	/>

	<section class="section" aria-labelledby="bio-title">
		<div class="container two-column bio-grid">
			<div>
				<p class="eyebrow">Biography</p>
				<h2 id="bio-title">Clinical excellence with a clear future lens.</h2>
				<p>
					Dr. Koche is recognized for helping people understand the true drivers of energy, metabolism,
					resilience, and long-term health trajectory. Her work centers on practical, physician-led clarity
					instead of trend-based protocols.
				</p>
				<p>
					As founder of Spectra Wellness, she has shaped a model of care that blends diagnostics,
					root-cause investigation, and personalized intervention planning. Her broader work expands
					this philosophy into future-ready systems for scalable preventative health.
				</p>
			</div>
			<ul>
				{milestones.map((milestone) => <li>{milestone}</li>)}
			</ul>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="philosophy-title">
		<div class="container">
			<SectionIntro
				id="philosophy-title"
				eyebrow="Philosophy"
				title="Healthcare should be anticipatory, not reactive."
				copy="The mission is to equip people with medical insight, agency, and long-horizon strategies they can sustain over time."
			/>
		</div>
	</section>

	<CTASection
		eyebrow="Consultation"
		title="Build your next decade of health with physician-level precision."
		copy="Start with a consultation to map your baseline, identify leverage points, and define a personalized longevity plan."
		primaryHref="/contact"
		primaryLabel="Book Consultation"
		secondaryHref="/programs"
		secondaryLabel="View Programs"
	/>
</Layout>

<style>
	.bio-grid h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.4rem);
		line-height: 1.06;
	}

	.bio-grid p:not(.eyebrow) {
		margin: var(--space-md) 0 0;
		color: var(--color-muted);
	}

	.bio-grid ul {
		display: grid;
		gap: var(--space-md);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.bio-grid li {
		padding: var(--space-lg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: rgba(255, 255, 255, 0.72);
		color: var(--color-muted);
	}
</style>
