---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import MediaGrid from "../components/MediaGrid.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import TopicCard from "../components/TopicCard.astro";
import { mediaAppearances } from "../data/media";

const topics = [
	["Sovereign Medicine", "How people can reclaim voice, agency, and discernment in their health journey"],
	["The LIT Journey", "A practical introduction to Dr. Lisa's framework for healing, performance, and alignment"],
	["Mitochondria & Cell Danger Response", "A clear translation of cellular energy, stress signaling, and recovery capacity"],
	["Heart-Centered Leadership", "Health, coherence, and burnout prevention for leaders and high-demand teams"],
	["Inner Harmony", "A science-and-spirit conversation about regulation, resilience, and whole-person vitality"],
];

const proof = [
	["Audience reach", "Tens of thousands worldwide"],
	["Experience", "20+ years in integrative and functional medicine"],
	["Notable stages", "Tony Robbins Summit, AgeMed Conference, Tampa General Hospital, Gasparilla Conference"],
];
---

<Layout
	title="Book Dr. Lisa Koche as a Speaker | Health, Resilience & Leadership"
	description="Invite Dr. Lisa Koche to speak on health literacy, longevity, resilience, sovereignty, mitochondria, and heart-centered leadership"
	currentPath="/speaking"
>
	<PageHero
		title="Transformational speaker and physician educator for health, performance, and leadership"
		copy="Dr. Lisa translates complex physiology into grounded, memorable teaching for audiences seeking science-backed health insight with a human and spiritually aware lens"
		primaryHref="#inquiry"
		primaryLabel="Request Availability"
		secondaryHref="/media"
		secondaryLabel="View Media"
		mediaLabel="Portrait or stage photography"
		mediaType="stage"
	/>

	<section class="section" aria-labelledby="intro-title">
		<div class="container two-column intro-grid">
			<div>
				<p class="eyebrow">Speaker</p>
				<h2 id="intro-title">A pioneer in integrative medicine with a clear stage presence</h2>
			</div>
			<p>
				Dr. Lisa is a triple board-certified physician, educator, speaker, and health literacy voice
				with more than two decades of professional experience. Her talks bring complex health ideas into
				language audiences can use
			</p>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="proof-title">
		<div class="container">
			<h2 class="visually-hidden" id="proof-title">Speaking experience</h2>
		</div>
		<div class="container proof-grid">
			{proof.map(([label, value]) => (
				<article class="card proof-card">
					<p>{label}</p>
					<h2>{value}</h2>
				</article>
			))}
		</div>
	</section>

	<section class="section" aria-labelledby="topics-title">
		<div class="container">
			<SectionIntro
				id="topics-title"
				eyebrow="Topics"
				title="Talks that make complex health easier to understand"
				copy="Each topic can be tailored for conferences, leadership rooms, wellness audiences, podcasts, and public education events"
			/>
			<div class="topic-grid">
				{topics.map(([title, copy]) => <TopicCard title={title} copy={copy} />)}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="media-title">
		<div class="container">
			<SectionIntro
				id="media-title"
				eyebrow="Media Proof"
				title="A physician voice already in public conversation"
				copy="Browse selected appearances or visit the full media page for a larger library"
			/>
			<MediaGrid items={mediaAppearances.slice(0, 6)} />
		</div>
	</section>

	<section class="section" id="inquiry" aria-labelledby="inquiry-title">
		<div class="container inquiry-layout">
			<div>
				<p class="eyebrow">Inquiry</p>
				<h2 id="inquiry-title">Request availability for your event or interview</h2>
				<p>
					Use these fields to prepare the key details for a speaking, podcast, interview, or professional
					education request
				</p>
			</div>
			<form class="speaking-form" action="#" method="get">
				<label>
					Name
					<input type="text" name="name" autocomplete="name" />
				</label>
				<label>
					Email
					<input type="email" name="email" autocomplete="email" />
				</label>
				<label>
					Event date
					<input type="text" name="event-date" />
				</label>
				<label>
					Subject
					<input type="text" name="subject" />
				</label>
				<label>
					Message
					<textarea name="message" rows="5"></textarea>
				</label>
				<button class="button button-primary" type="submit">Prepare Inquiry</button>
			</form>
		</div>
	</section>

	<CTASection
		eyebrow="Booking"
		title="Invite Dr. Lisa to speak"
		copy="Use the inquiry section for speaking, podcast, interview, and professional education requests"
		primaryHref="#inquiry"
		primaryLabel="Request Availability"
		secondaryHref="/media"
		secondaryLabel="View Media"
	/>
</Layout>

<style>
	.intro-grid {
		align-items: start;
	}

	.intro-grid h2,
	.inquiry-layout h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.05rem, 4vw, 3.8rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.intro-grid p,
	.inquiry-layout p {
		color: var(--color-muted);
	}

	.proof-grid,
	.topic-grid {
		display: grid;
		gap: var(--space-lg);
	}

	.topic-grid,
	:global(.media-grid) {
		margin-top: var(--space-2xl);
	}

	.proof-card {
		min-height: 12rem;
		padding: clamp(1.25rem, 3vw, 1.85rem);
	}

	.proof-card p {
		margin: 0 0 var(--space-lg);
		color: var(--color-spectra-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.proof-card h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 3vw, 2.6rem);
		font-weight: 400;
		line-height: 1.05;
	}

	.inquiry-layout {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.speaking-form {
		display: grid;
		gap: var(--space-md);
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.68)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-spectrum);
	}

	label {
		display: grid;
		gap: var(--space-xs);
		color: var(--color-spectra-teal);
		font-size: 0.84rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	input,
	textarea {
		width: 100%;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.78);
		color: var(--color-text);
		font-size: 1rem;
		letter-spacing: 0;
		text-transform: none;
	}

	input {
		min-height: 3rem;
		padding: 0 0.9rem;
	}

	textarea {
		padding: 0.8rem 0.9rem;
		resize: vertical;
	}

	input:focus,
	textarea:focus {
		border-color: rgba(216, 76, 159, 0.42);
		box-shadow: 0 0 0 4px rgba(80, 166, 163, 0.16);
		outline: none;
	}

	.speaking-form .button {
		width: fit-content;
		margin-top: var(--space-sm);
	}

	@media (min-width: 760px) {
		.proof-grid,
		.topic-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 900px) {
		.inquiry-layout {
			grid-template-columns: 0.8fr 1fr;
		}
	}
</style>
