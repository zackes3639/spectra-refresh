---
import CTASection from "../../components/CTASection.astro";
import Layout from "../../components/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import { articleResources, featuredResources } from "../../data/resources";
---

<Layout
	title="Insights | Dr. Lisa Koche"
	description="Legacy insights hub for resources, articles, and education from Dr. Lisa Koche"
	currentPath="/insights"
>
	<PageHero
		title="Insights now live in the resources library"
		copy="This legacy path remains available for visitors who expect an insights page, while the refreshed site uses Resources as the primary education hub"
		primaryHref="/resources"
		primaryLabel="Open Resources"
		secondaryHref="/programs"
		secondaryLabel="Dr. Lisa Programs"
		mediaLabel="Editorial imagery"
	/>

	<section class="section" aria-labelledby="featured-title">
		<div class="container">
			<SectionIntro
				id="featured-title"
				eyebrow="Featured Resources"
				title="Start with the most useful education pathways"
				copy="Resources include free guides, courses, favorites, and public articles"
			/>
			<div class="featured-grid">
				{featuredResources.slice(0, 3).map((resource) => <ResourceCard resource={resource} featured />)}
			</div>
		</div>
	</section>

	<section class="section section-soft" id="articles" aria-labelledby="articles-title">
		<div class="container">
			<SectionIntro id="articles-title" eyebrow="Articles" title="Read recent health education" />
			<div class="article-grid">
				{articleResources.map((resource) => <ResourceCard resource={resource} />)}
			</div>
		</div>
	</section>

	<CTASection
		eyebrow="Resources"
		title="Use the refreshed resources hub for education"
		copy="Browse free resources, articles, and learning pathways from Dr. Lisa's platform"
		primaryHref="/resources"
		primaryLabel="Open Resources"
		secondaryHref="/contact"
		secondaryLabel="Contact"
	/>
</Layout>

<style>
	.featured-grid,
	.article-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	@media (min-width: 760px) {
		.featured-grid,
		.article-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
