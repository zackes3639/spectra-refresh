---
import CTASection from "../components/CTASection.astro";
import EditorialArtFrame from "../components/EditorialArtFrame.astro";
import Layout from "../components/Layout.astro";
import MetricStrip from "../components/MetricStrip.astro";
import PageHero from "../components/PageHero.astro";
import PathwayCard from "../components/PathwayCard.astro";
import SectionIntro from "../components/SectionIntro.astro";
import TimelineList from "../components/TimelineList.astro";
import { siteLinks } from "../data/site";

const waysIn = [
	{
		title: "Story",
		copy: "Meet the founder behind the platform",
		href: "/about",
		cta: "Meet",
		icon: "story",
	},
	{
		title: "Invite",
		copy: "Book speaking, podcasts, or interviews",
		href: "/speaking",
		cta: "Book",
		icon: "invite",
	},
	{
		title: "Learn",
		copy: "Browse resources, programs, and favorites",
		href: "/resources",
		cta: "Read",
		icon: "learn",
	},
	{
		title: "Spectra",
		copy: "Visit the practice site",
		href: siteLinks.spectraWellness,
		cta: "Visit",
		icon: "spectra",
	},
];

const proofItems = [
	{
		value: "Founder",
		label: "Spectra Wellness",
		copy: "Built the organization that became home to her broader vision",
	},
	{
		value: "Physician",
		label: "Medical perspective",
		copy: "Her training informs the way she teaches, writes, and leads",
	},
	{
		value: "Educator",
		label: "Health literacy",
		copy: "Translates complex ideas into language people can use",
	},
	{
		value: "Speaker",
		label: "Public voice",
		copy: "Brings a grounded, human message to audiences and interviews",
	},
];

const storyMoments = [
	{
		title: "Origin story",
		copy: "Her personal experience shaped the empathy and persistence behind the work",
	},
	{
		title: "Founder's vision",
		copy: "Spectra Wellness grew from a desire to build something more human and integrative",
	},
	{
		title: "Public education",
		copy: "Her platform helps people ask clearer questions and trust their own discernment",
	},
	{
		title: "The next chapter",
		copy: "This site centers Dr. Lisa's voice, story, resources, media, and invitations",
	},
];

---

<Layout
	title="Dr. Lisa Koche | Founder, Physician, Educator & Speaker"
	description="Meet Dr. Lisa Koche, the founder, physician, educator, speaker, and advocate behind Spectra Wellness and a broader platform for health literacy"
	currentPath="/"
>
	<PageHero
		title="Dr. Lisa Koche"
		titleLines={["Dr. Lisa Koche", "educator", "advocate", "healer"]}
		copy="The physician, educator, speaker, advocate, and healer behind Spectra Wellness and a larger conversation about resilience, agency, and health literacy"
		primaryHref="/about"
		primaryLabel="Meet Dr. Lisa"
		secondaryHref="/speaking"
		secondaryLabel="Speaking & Media"
		mediaLabel="Dr. Lisa Koche portrait"
		imageSrc="/images/dr-lisa-koche-headshot.jpeg"
		imageAlt="Dr. Lisa Koche"
		mediaType="portrait"
		variant="home"
		imagePosition="50% 34%"
		mobileImagePosition="50% 30%"
		imageScale="1.08"
		mobileImageScale="1.08"
	/>

	<section class="section wayfinding-section" aria-labelledby="ways-title">
		<div class="container">
			<h2 class="visually-hidden" id="ways-title">Ways to begin</h2>
			<div class="wayfinding-grid">
				{waysIn.map((item, index) => (
					<PathwayCard
						title={item.title}
						copy={item.copy}
						href={item.href}
						icon={item.icon}
						ctaLabel={item.cta}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft promise-section" aria-labelledby="promise-title">
		<div class="container promise-layout">
			<SectionIntro
				id="promise-title"
				eyebrow="Why Dr. Lisa"
				title="The person behind the platform"
				copy="The refreshed site is intentionally about Dr. Lisa herself: her story, her public voice, her education work, and the vision that became Spectra Wellness"
			/>
			<div class="promise-body">
				<MetricStrip items={proofItems} ariaLabel="Dr. Lisa proof points" />
				<!-- Generated concept art; replace with approved brand photography when available. -->
				<EditorialArtFrame src="/images/generated/root-cause-still-life.png" alt="" aspect="wide" />
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="story-title">
		<div class="container editorial-grid story-grid">
			<!-- Generated concept art; replace with approved founder-story photography when available. -->
			<EditorialArtFrame src="/images/generated/founder-story-still-life.png" alt="" aspect="wide" />
			<div class="copy-stack">
				<SectionIntro
					id="story-title"
					eyebrow="Founder Story"
					title="Her Story, Her Voice"
					copy="Dr. Lisa's work has always been shaped by a desire to make complex health ideas more humane, more practical, and easier to discuss"
				/>
				<TimelineList items={storyMoments} ariaLabel="Dr. Lisa founder story" />
			</div>
		</div>
	</section>

	<CTASection
		eyebrow=""
		title="Follow Dr. Lisa's work"
		copy="Explore her story, resources, speaking, or visit Spectra Wellness for practice details"
		compactLayout={true}
		primaryHref="/about"
		primaryLabel="Meet Dr. Lisa"
		secondaryHref={siteLinks.spectraWellness}
		secondaryLabel="Spectra Wellness"
	/>
</Layout>

<style>
	.wayfinding-section {
		padding-top: clamp(var(--space-48), 5vw, var(--space-64));
	}

	.wayfinding-grid {
		display: grid;
		gap: var(--space-lg);
	}

	:global(.wayfinding-grid .pathway-card) {
		min-height: 11rem;
		gap: var(--space-16);
	}

	:global(.wayfinding-grid .pathway-card h3) {
		font-size: clamp(1.55rem, 2.1vw, 2.15rem);
	}

	:global(.wayfinding-grid .pathway-card div > span) {
		margin-top: var(--space-8);
		font-size: 0.86rem;
		line-height: 1.45;
	}

	:global(.wayfinding-grid .pathway-card strong) {
		font-size: 0.78rem;
	}

	.editorial-grid {
		display: grid;
		gap: clamp(var(--space-32), 6vw, var(--space-80));
		align-items: center;
	}

	.section.promise-section {
		padding-top: clamp(var(--space-56), 6vw, var(--space-80));
	}

	.promise-layout {
		display: grid;
		gap: clamp(var(--space-32), 4vw, var(--space-48));
	}

	.promise-body {
		display: grid;
		gap: clamp(var(--space-32), 6vw, var(--space-80));
		align-items: center;
	}

	:global(.promise-section .section-intro) {
		max-width: 100%;
	}

	:global(.promise-section .section-intro .eyebrow) {
		margin-bottom: var(--space-12);
		font-size: clamp(0.82rem, 0.22vw + 0.76rem, 0.94rem);
		font-weight: 800;
	}

	:global(.promise-section .section-intro .section-heading) {
		max-width: 100%;
		font-size: clamp(2.65rem, 4.6vw, 5rem);
		line-height: 1.04;
	}

	:global(.promise-section .section-intro .section-copy) {
		max-width: 100%;
		font-size: clamp(1.05rem, 1.08vw, 1.22rem);
		line-height: 1.62;
	}

	.copy-stack {
		display: grid;
		gap: clamp(var(--space-24), 4vw, var(--space-40));
	}

	@media (min-width: 760px) and (max-width: 999px) {
		.wayfinding-section {
			padding-top: var(--space-64);
		}

		.wayfinding-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.editorial-grid {
			gap: var(--space-40);
		}

		.editorial-grid :global(.editorial-art-frame) {
			width: 100%;
			max-width: 40rem;
			margin-inline: auto;
		}

		.promise-body :global(.editorial-art-frame) {
			width: 100%;
			max-width: 40rem;
			margin-inline: auto;
		}

		.copy-stack {
			gap: var(--space-32);
		}
	}

	@media (min-width: 1000px) {
		.wayfinding-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (min-width: 900px) {
		.promise-body {
			grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.74fr);
		}

		.story-grid {
			grid-template-columns: minmax(22rem, 0.76fr) minmax(0, 1fr);
		}

		.story-grid > :global(.editorial-art-frame img) {
			height: clamp(28rem, 34vw, 36rem);
			aspect-ratio: auto;
			object-position: center;
		}
	}

	@media (min-width: 1100px) {
		:global(.promise-section .section-intro .section-heading) {
			text-wrap: nowrap;
			white-space: nowrap;
		}
	}

	@media (max-width: 759px) {
		.wayfinding-section {
			padding-top: var(--space-40);
		}
	}
</style>
