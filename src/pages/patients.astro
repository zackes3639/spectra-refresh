---
import ContactCard from "../components/ContactCard.astro";
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { practiceInfo, siteLinks } from "../data/site";

const fastLinks = [
	{ title: "Patient Portal", copy: "Access the existing patient portal for patient-system communication.", href: siteLinks.patientPortal, label: "Open portal" },
	{ title: "New Patient Information", copy: "Review current live-site patient information and form guidance.", href: siteLinks.patientInformation, label: "View information" },
	{ title: "Call the Office", copy: "Best for scheduling questions, provider routing, and current policy confirmation.", href: practiceInfo.phoneHref, label: practiceInfo.phone },
	{ title: "Care Discovery", copy: "For patients interested in deeper functional medicine care.", href: siteLinks.discoveryCall, label: "Book discovery" },
];
---

<Layout
	title="Patient Information | Dr. Lisa Koche"
	description="Access patient portal, new patient information, pricing guidance, insurance notes, and forms for Dr. Lisa's Tampa clinical practice."
	currentPath="/patients"
>
	<PageHero
		title="Everything you need before your visit."
		copy="Use this hub to find portal access, appointment routing, insurance notes, and safety guidance before contacting the office."
		primaryHref={practiceInfo.phoneHref}
		primaryLabel={`Call ${practiceInfo.phone}`}
		secondaryHref={siteLinks.patientPortal}
		secondaryLabel="Patient Portal"
		mediaLabel="Patient information imagery"
	/>

	<section class="section" aria-labelledby="links-title">
		<div class="container">
			<SectionIntro
				id="links-title"
				eyebrow="Fast Links"
				title="Choose the next step that matches your need."
				copy="These links route to existing patient destinations, booking tools, and internal information pages."
			/>
			<div class="fast-grid">
				{fastLinks.map((link) => <ContactCard {...link} />)}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="insurance-title">
		<div class="container patient-panel">
			<div>
				<p class="eyebrow">Insurance & Pricing</p>
				<h2 id="insurance-title">Coverage details should be confirmed before care begins.</h2>
			</div>
			<div>
				<p>
					Current live-site direction indicates Dr. Angeline Galiano and Rodney Morillo may accept many
					PPO policies for primary care. Other providers, including Dr. Lisa, are generally self-pay.
				</p>
				<p>
					The practice does not appear to accept Medicare, Medicare replacement, or Medicare Advantage plans.
					Patients should verify in-network status directly with their insurance company and the practice
					before scheduling.
				</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="appointment-title">
		<div class="container visit-grid">
			<article class="card visit-card">
				<h2 id="appointment-title">Appointment options</h2>
				<ul>
					<li>Call the office for patient routing and current scheduling guidance.</li>
					<li>Use the patient portal only for appropriate existing-patient communication.</li>
					<li>Use Mindbody for performance and longevity therapy booking when appropriate.</li>
					<li>Book a discovery call for high-level care fit conversations.</li>
				</ul>
			</article>
			<article class="card visit-card notice">
				<h2>Privacy and urgent-care note</h2>
				<p>
					Do not submit protected health information, urgent symptoms, or emergency concerns through a
					general website form. Call the practice for routine questions, use the patient portal when
					appropriate, or call 911 for emergencies.
				</p>
			</article>
		</div>
	</section>

	<CTASection
		title="Need help choosing a path?"
		copy="The office team can help route you to patient care, performance therapies, or a provider-specific next step."
		primaryHref={practiceInfo.phoneHref}
		primaryLabel={`Call ${practiceInfo.phone}`}
		secondaryHref="/contact"
		secondaryLabel="Contact the Practice"
	/>
</Layout>

<style>
	.fast-grid,
	.visit-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.patient-panel {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.patient-panel h2,
	.visit-card h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.6rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.patient-panel p,
	.visit-card p,
	.visit-card li {
		color: var(--color-muted);
	}

	.visit-card {
		padding: clamp(1.35rem, 3vw, 2rem);
	}

	.visit-card ul {
		display: grid;
		gap: var(--space-sm);
		padding: 0;
		margin: var(--space-lg) 0 0;
		list-style: none;
	}

	.visit-card li {
		padding-top: var(--space-sm);
		border-top: 1px solid rgba(80, 166, 163, 0.18);
	}

	.notice {
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.84), rgba(220, 239, 238, 0.62)),
			radial-gradient(circle at 90% 10%, rgba(226, 96, 151, 0.12), transparent 11rem);
	}

	@media (min-width: 760px) {
		.fast-grid,
		.visit-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 980px) {
		.patient-panel {
			grid-template-columns: 0.85fr 1fr;
		}

		.fast-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
