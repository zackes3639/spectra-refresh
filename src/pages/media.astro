---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import MediaGrid from "../components/MediaGrid.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { mediaAppearances } from "../data/media";
---

<Layout
	title="Media | Dr. Lisa Koche"
	description="Browse Dr. Lisa Koche's TV, podcast, article, and video appearances on functional medicine, biohacking, hormones, sleep, immunity, and longevity."
	currentPath="/media"
>
	<PageHero
		title="Dr. Lisa in the media."
		copy="A curated press and media hub for Dr. Lisa's physician voice across television, podcasts, articles, and public education."
		primaryHref="/speaking"
		primaryLabel="Invite Dr. Lisa"
		secondaryHref="#media-grid"
		secondaryLabel="Browse Appearances"
		mediaLabel="Media appearance imagery"
		mediaType="stage"
	/>

	<section class="section" aria-labelledby="feature-title">
		<div class="container media-feature">
			<div class="video-placeholder" aria-label="Featured media video area">
				<span aria-hidden="true"></span>
				<p class="placeholder-note">Featured Video</p>
			</div>
			<div>
				<p class="eyebrow">Featured</p>
				<h2 id="feature-title">A physician voice for science, sovereignty, and practical health literacy.</h2>
				<p>
					Selected clips and appearances can be highlighted here as approved videos and thumbnails become
					available. The hub below links to public media destinations.
				</p>
			</div>
		</div>
	</section>

	<section class="section section-soft" id="media-grid" aria-labelledby="media-title">
		<div class="container">
			<SectionIntro
				id="media-title"
				eyebrow="Appearances"
				title="Interviews, articles, and educational segments."
				copy="Links route to public media pages where available, with selected appearances organized for easier browsing."
			/>
			<MediaGrid items={mediaAppearances} />
		</div>
	</section>

	<CTASection
		title="Bring Dr. Lisa's physician voice to your audience."
		copy="Route speaking, podcast, and media inquiries through Dr. Lisa's dedicated speaking page or contact page."
		primaryHref="/speaking"
		primaryLabel="Speaking Inquiry"
		secondaryHref="/contact"
		secondaryLabel="Contact"
	/>
</Layout>

<style>
	.media-feature {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
	}

	.media-feature h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.05rem, 4vw, 3.8rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.media-feature p:not(.eyebrow, .placeholder-note) {
		color: var(--color-muted);
	}

	.video-placeholder {
		position: relative;
		display: grid;
		min-height: 24rem;
		place-items: center;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(145deg, rgba(49, 70, 58, 0.96), rgba(30, 36, 33, 0.98)),
			radial-gradient(circle at 72% 18%, rgba(215, 196, 140, 0.2), transparent 13rem);
		box-shadow: var(--shadow-soft);
	}

	.video-placeholder span {
		width: 4.5rem;
		aspect-ratio: 1;
		border: 1px solid rgba(247, 248, 245, 0.44);
		border-radius: 50%;
		background: rgba(247, 248, 245, 0.1);
	}

	.video-placeholder .placeholder-note {
		position: absolute;
		bottom: var(--space-lg);
		color: rgba(247, 248, 245, 0.64);
	}

	:global(#media-grid .media-grid) {
		margin-top: var(--space-2xl);
	}

	@media (min-width: 940px) {
		.media-feature {
			grid-template-columns: minmax(22rem, 0.85fr) 1fr;
		}
	}
</style>
