---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { testimonials } from "../data/testimonials";
---

<Layout
	title="Patient Testimonials | Dr. Lisa Koche"
	description="Read patient experience themes connected to Dr. Lisa Koche's functional medicine, chiropractic, primary care, and root-cause wellness team."
	currentPath="/testimonials"
>
	<PageHero
		title="Patients who felt heard, supported, and guided."
		copy="Read safety-conscious testimonial themes that emphasize trust, continuity, and whole-person support without exaggerated claims."
		primaryHref="/contact"
		primaryLabel="Start Your Conversation"
		secondaryHref="/team"
		secondaryLabel="Meet the Team"
		mediaLabel="Patient testimonial imagery"
	/>

	<section class="section" aria-labelledby="stories-title">
		<div class="container">
			<SectionIntro
				id="stories-title"
				eyebrow="Patient Themes"
				title="The recurring thread is a more human care experience."
				copy="These summaries preserve the spirit of patient experience while avoiding cure claims or guaranteed outcomes."
			/>
			<div class="testimonial-grid">
				{testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} />)}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="review-title">
		<div class="container review-panel">
			<p class="eyebrow">Testimonial Standards</p>
			<h2 id="review-title">Patient stories should stay specific, permitted, and measured.</h2>
			<p>
				Any exact quote should have permission, context, and medical-claim review before publication.
				Avoid language that implies guaranteed results, disease cures, or a substitute for individualized care.
			</p>
		</div>
	</section>

	<CTASection
		title="Start your own conversation with the office."
		copy="Begin with patient information, a discovery call, or a direct contact route to understand the right next step."
		primaryHref="/contact"
		primaryLabel="Contact the Practice"
		secondaryHref="/patients"
		secondaryLabel="Patient Information"
	/>
</Layout>

<style>
	.testimonial-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.review-panel {
		max-width: 60rem;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.78), rgba(220, 239, 238, 0.48)),
			radial-gradient(circle at 88% 18%, rgba(244, 201, 93, 0.16), transparent 14rem);
		box-shadow: var(--shadow-card);
	}

	.review-panel h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.6rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.review-panel p:not(.eyebrow) {
		color: var(--color-muted);
	}

	@media (min-width: 760px) {
		.testimonial-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
