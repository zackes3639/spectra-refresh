---
import CTASection from "../components/CTASection.astro";
import IconMark, { type IconMarkName } from "../components/IconMark.astro";
import Layout from "../components/Layout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { siteLinks } from "../data/site";

const processSteps = [
	{
		title: "Listen",
		label: "Whole story",
		copy: "Start with history, stress, symptoms, environment, capacity, and goals",
		cues: ["Timeline", "Context", "Concerns"],
	},
	{
		title: "Map",
		label: "Body signals",
		copy: "Look for patterns across systems, not one isolated data point",
		cues: ["Patterns", "Systems", "Signals"],
	},
	{
		title: "Translate",
		label: "Plain language",
		copy: "Turn complex ideas into plain language people can use",
		cues: ["Clarity", "Literacy", "Discernment"],
	},
	{
		title: "Choose",
		label: "Right next step",
		copy: "Match the moment to learning, conversation, community, or Spectra",
		cues: ["Resources", "Speaking", "Spectra"],
	},
	{
		title: "Refine",
		label: "Ongoing support",
		copy: "Return with more information, more agency, and steadier trust in the body",
		cues: ["Resilience", "Agency", "Integration"],
	},
];

const principles = [
	{
		title: "Context Before Conclusions",
		copy: "The work starts with story, biology, lived experience, and the conditions surrounding the person",
		icon: "context",
	},
	{
		title: "Clarity Over Confusion",
		copy: "Dr. Lisa’s public voice makes advanced health concepts easier to discuss, question, and apply",
		icon: "clarity",
	},
	{
		title: "Agency Before Passivity",
		copy: "The goal is a more informed person who can ask better questions and participate with confidence",
		icon: "agency",
	},
] satisfies Array<{ title: string; copy: string; icon: IconMarkName }>;

const pathways = [
	{
		title: "Learn",
		copy: "Use articles, guides, favorites, and courses to understand the foundation before choosing a deeper path",
		href: "/resources",
		label: "Resources",
	},
	{
		title: "Invite",
		copy: "Bring Dr. Lisa into a stage, podcast, leadership room, or community conversation",
		href: "/speaking",
		label: "Speaking",
	},
	{
		title: "Visit",
		copy: "For appointments, membership, office details, and clinical care, continue to Spectra Wellness",
		href: siteLinks.spectraWellness,
		label: "Spectra",
		external: true,
	},
];
---

<Layout
	title="Dr. Lisa's Approach | Process, Education & Agency"
	description="Explore Dr. Lisa Koche's process for listening deeply, finding patterns, translating complex health ideas, and helping people choose their next step"
	currentPath="/approach"
>
	<section class="approach-hero" aria-labelledby="approach-hero-title">
		<div class="container approach-hero-layout">
			<div class="approach-hero-copy">
				<h1 id="approach-hero-title">Start with the whole story</h1>
				<p>
					Dr. Lisa's approach moves from listening to pattern recognition, then into education,
					discernment, and the right next step for the person in front of her
				</p>
				<div class="approach-hero-actions">
					<a class="button button-primary" href="/resources">Start Learning</a>
					<a class="button button-secondary" href={siteLinks.spectraWellness} target="_blank" rel="noopener noreferrer">Visit Spectra</a>
				</div>
			</div>
			<div class="approach-hero-focus" aria-label="Approach themes">
				<span>listen deeply</span>
				<span>map patterns</span>
				<span>choose clearly</span>
			</div>
		</div>
	</section>

	<section class="section process-section" aria-labelledby="process-title">
		<div class="container process-container">
			<SectionIntro
				id="process-title"
				eyebrow="Dr Lisa's Approach"
				title="From story to next step"
				copy="The flow is simple on purpose: hear the person, understand the pattern, translate the signal, and choose the pathway with care"
			/>
			<div class="process-flow" aria-label="Dr. Lisa's approach process">
				{processSteps.map((step, index) => (
					<article class="process-step">
						<div class="step-kicker">
							<span class="step-marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
							<p>{step.label}</p>
						</div>
						<h3>{step.title}</h3>
						<div class="step-copy">
							<p>{step.copy}</p>
						</div>
						<ul>
							{step.cues.map((cue) => <li>{cue}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft principle-section" aria-labelledby="principles-title">
		<div class="container principle-layout">
				<div class="principle-statement">
					<p class="eyebrow">How It Feels</p>
					<h2 class="stacked-principle-title" id="principles-title">
						<span>calm</span>
						<span>curious</span>
						<span>precise</span>
					</h2>
					<p>
						Dr Lisa's process is not a shortcut around complexity; it is a way to make complexity more humane,
						usable, and less isolating
				</p>
			</div>
			<div class="principle-list">
				{principles.map((principle) => (
					<article>
						<IconMark name={principle.icon} />
						<div>
							<h3>{principle.title}</h3>
							<p>{principle.copy}</p>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section signal-section" aria-labelledby="signal-title">
			<div class="container signal-panel">
				<div>
					<p class="eyebrow">Root-Cause Lens</p>
					<h2 class="stacked-signal-title" id="signal-title">
						<span>signals</span>
						<span>systems</span>
						<span>story</span>
					</h2>
				</div>
				<p>
					Dr. Lisa’s public teaching keeps returning to the same larger idea: the <strong>body</strong>
					makes more sense when its <strong>systems</strong>, <strong>environment</strong>,
					<strong>history</strong>, and <strong>inner life</strong> are considered together
				</p>
			</div>
	</section>

	<section class="section section-soft pathway-section" aria-labelledby="pathway-title">
		<div class="container">
			<SectionIntro
				id="pathway-title"
				eyebrow="Next Steps"
				title="The right door depends on what you need"
				copy="This site keeps the focus on Dr. Lisa’s story, voice, resources, and invitations. Clinical details stay with Spectra Wellness"
			/>
			<div class="pathway-grid">
				{pathways.map((pathway) => (
					<a
						class="pathway-card"
						href={pathway.href}
						target={pathway.external ? "_blank" : undefined}
						rel={pathway.external ? "noopener noreferrer" : undefined}
					>
						<span>{pathway.label}</span>
						<h3>{pathway.title}</h3>
						<p>{pathway.copy}</p>
					</a>
				))}
			</div>
		</div>
	</section>

	<CTASection
		title="Start with the clearest next step"
		copy="Explore Dr. Lisa's resources, invite her to speak, or continue to Spectra Wellness for practice information"
		primaryHref="/resources"
		primaryLabel="Explore Resources"
		secondaryHref="/speaking"
		secondaryLabel="Invite Dr. Lisa"
		singleLineTitle
	/>
</Layout>

<style>
	.approach-hero {
		position: relative;
		overflow: hidden;
		padding: clamp(var(--space-56), 7vw, var(--space-96)) 0 clamp(var(--space-40), 5vw, var(--space-64));
		background:
			radial-gradient(circle at 12% 24%, rgba(243, 204, 114, 0.14), transparent 19rem),
			radial-gradient(circle at 84% 18%, rgba(40, 156, 176, 0.15), transparent 22rem),
			radial-gradient(circle at 78% 82%, rgba(122, 117, 207, 0.08), transparent 21rem),
			linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(215, 239, 244, 0.42));
		border-bottom: 1px solid rgba(40, 156, 176, 0.1);
	}

	.approach-hero::before {
		position: absolute;
		inset: 0 0 auto;
		height: 0.24rem;
		background: var(--gradient-spectrum);
		content: "";
		opacity: 0.68;
	}

	.approach-hero-layout {
		position: relative;
		z-index: 1;
		display: grid;
		gap: clamp(var(--space-32), 6vw, var(--space-80));
		align-items: end;
	}

	.approach-hero-copy {
		max-width: 58rem;
	}

	.approach-hero h1 {
		max-width: 14ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 7.2vw, 6.4rem);
		font-weight: 420;
		letter-spacing: 0;
		line-height: 0.98;
	}

	.approach-hero-copy p {
		max-width: min(43rem, var(--max-text-width));
		margin: var(--space-24) 0 0;
		color: var(--color-muted);
		font-size: clamp(1.04rem, 1.25vw, 1.18rem);
		line-height: 1.62;
	}

	.approach-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-16);
		margin-top: var(--space-32);
	}

	.approach-hero-focus {
		display: grid;
		gap: var(--space-8);
		max-width: 29rem;
	}

	.approach-hero-focus span {
		display: block;
		font-family: var(--font-display);
		font-size: clamp(2rem, 3.55vw, 3.65rem);
		font-weight: 400;
		line-height: 0.96;
		text-wrap: balance;
	}

	.approach-hero-focus span:nth-child(1) {
		color: var(--color-spectra-teal);
	}

	.approach-hero-focus span:nth-child(2) {
		color: var(--color-spectra-violet);
	}

	.approach-hero-focus span:nth-child(3) {
		color: var(--color-longevity-gold);
	}

	.process-section {
		padding-top: clamp(var(--space-48), 5vw, var(--space-64));
	}

	.process-flow {
		position: relative;
		display: grid;
		gap: var(--space-16);
		margin-top: var(--space-48);
	}

	.process-container {
		--container: 1400px;
	}

	.process-section :global(.section-intro) {
		max-width: 100%;
	}

	.process-section :global(.section-copy) {
		max-width: min(100%, 76rem);
	}

	.process-step {
		position: relative;
		display: grid;
		gap: var(--space-16);
		align-items: start;
		padding: clamp(var(--space-24), 3vw, var(--space-32));
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.74)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-card);
	}

	.process-step::after {
		position: absolute;
		top: calc(100% + var(--space-4));
		left: calc(var(--space-24) + 1rem);
		width: 1px;
		height: var(--space-16);
		background: linear-gradient(180deg, rgba(40, 156, 176, 0.36), rgba(122, 117, 207, 0.2));
		content: "";
	}

	.process-step:last-child::after {
		display: none;
	}

	.step-kicker {
		position: relative;
		z-index: 1;
		display: flex;
		min-height: 1.65rem;
		align-items: center;
		gap: var(--space-8);
	}

	.step-marker {
		display: inline-grid;
		min-width: 2.15rem;
		height: 1.55rem;
		place-items: center;
		border: 1px solid rgba(40, 156, 176, 0.26);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.68);
		color: var(--color-spectra-teal);
		font-size: 0.68rem;
		font-variant-numeric: tabular-nums;
		font-weight: 850;
		letter-spacing: 0.08em;
		line-height: 1;
		box-shadow: 0 8px 18px rgba(40, 156, 176, 0.1);
	}

	.step-kicker p {
		margin: 0;
		color: var(--color-spectra-teal);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1;
		text-transform: uppercase;
	}

	.process-step h3,
	.principle-statement h2,
	.signal-panel h2,
	.pathway-card h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 400;
		line-height: 1.03;
	}

	.process-step h3 {
		font-size: clamp(1.95rem, 2.2vw, 2.45rem);
	}

	.step-copy p,
	.principle-statement p,
	.principle-list p,
	.signal-panel p,
	.pathway-card p {
		margin: 0;
		color: var(--color-muted);
	}

	.step-copy p {
		max-width: 34rem;
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.process-step ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-8);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.process-step li {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.42rem 0.72rem;
		border: 1px solid rgba(40, 156, 176, 0.18);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.66);
		color: rgba(22, 33, 40, 0.64);
		font-size: 0.78rem;
		font-weight: 750;
	}

	.principle-layout {
		display: grid;
		gap: clamp(var(--space-32), 6vw, var(--space-64));
		align-items: start;
	}

	.principle-statement {
		max-width: 42rem;
	}

	.principle-statement h2,
	.signal-panel h2 {
		font-size: clamp(2.4rem, 5vw, 5rem);
	}

	.stacked-principle-title {
		display: grid;
		gap: 0;
		text-transform: lowercase;
	}

	.stacked-principle-title span {
		display: block;
	}

	.stacked-signal-title {
		display: grid;
		gap: 0;
		text-transform: lowercase;
	}

	.stacked-signal-title span {
		display: block;
	}

	.principle-statement p {
		max-width: min(42rem, var(--max-text-width));
		margin-top: var(--space-24);
		font-size: clamp(1.02rem, 1.2vw, 1.18rem);
		line-height: 1.62;
	}

	.principle-list {
		display: grid;
		gap: var(--space-16);
	}

	.principle-list article {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: var(--space-16);
		align-items: start;
		padding: var(--space-24);
		border: 1px solid rgba(40, 156, 176, 0.18);
		border-radius: var(--radius-lg);
		background: rgba(255, 255, 255, 0.64);
		box-shadow: 0 12px 28px rgba(80, 166, 163, 0.08);
	}

	.principle-list :global(.icon-mark) {
		display: inline-grid;
		width: 2.5rem;
		aspect-ratio: 1;
		margin-top: 0.05rem;
		place-items: center;
		border: 1px solid rgba(40, 156, 176, 0.16);
		border-radius: 0.9rem;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(215, 239, 244, 0.32)),
			rgba(255, 255, 255, 0.72);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.58),
			0 10px 22px rgba(80, 166, 163, 0.1);
	}

	.principle-list :global(.icon-mark[data-icon="context"]) {
		color: var(--color-spectra-teal);
	}

	.principle-list :global(.icon-mark[data-icon="clarity"]) {
		color: var(--color-spectra-violet);
	}

	.principle-list :global(.icon-mark[data-icon="agency"]) {
		color: var(--color-longevity-gold);
	}

	.principle-list :global(.icon-mark svg) {
		width: 1.4rem;
		height: 1.4rem;
	}

	.principle-list :global(.icon-line) {
		stroke: currentColor;
		stroke-width: 1.6;
	}

	.principle-list :global(.icon-accent-dot) {
		fill: currentColor;
	}

	.principle-list h3 {
		margin: 0;
		color: var(--color-deep-evergreen);
		font-size: 1rem;
		line-height: 1.24;
	}

	.principle-list p {
		margin-top: var(--space-8);
		font-size: 0.95rem;
		line-height: 1.56;
	}

	.signal-panel {
		display: grid;
		gap: clamp(var(--space-32), 6vw, var(--space-64));
		align-items: center;
		padding: clamp(var(--space-32), 5vw, var(--space-64));
		border: 1px solid rgba(80, 166, 163, 0.28);
		border-radius: var(--radius-xl);
		background:
			radial-gradient(circle at 12% 18%, rgba(40, 156, 176, 0.2), transparent 14rem),
			radial-gradient(circle at 84% 24%, rgba(122, 117, 207, 0.18), transparent 15rem),
			radial-gradient(circle at 88% 86%, rgba(222, 184, 94, 0.18), transparent 13rem),
			linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(215, 239, 244, 0.54));
		box-shadow: var(--shadow-spectrum);
	}

	.signal-panel p {
		max-width: min(44rem, var(--max-text-width));
		font-size: clamp(1.05rem, 1.4vw, 1.28rem);
		line-height: 1.62;
	}

	.signal-panel strong {
		color: var(--color-deep-evergreen);
		font-weight: 850;
	}

	.pathway-grid {
		display: grid;
		gap: var(--space-24);
		margin-top: var(--space-48);
	}

	.pathway-section :global(.section-intro) {
		max-width: 100%;
	}

	.pathway-section :global(.section-heading) {
		max-width: 100%;
	}

	.pathway-section :global(#pathway-title) {
		font-size: clamp(2.55rem, 3.75vw, 3.9rem);
		white-space: nowrap;
	}

	.pathway-section :global(.section-copy) {
		max-width: min(100%, 62rem);
	}

	.pathway-card {
		position: relative;
		display: grid;
		gap: var(--space-16);
		min-height: 16rem;
		padding: clamp(var(--space-24), 3vw, var(--space-32));
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.72)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-card);
		transition:
			transform var(--transition),
			border-color var(--transition),
			box-shadow var(--transition);
	}

	.pathway-card::before {
		position: absolute;
		inset: 0 0 auto;
		height: 0.28rem;
		background: var(--gradient-spectrum);
		content: "";
		opacity: 0.64;
	}

	.pathway-card:hover {
		transform: translateY(-3px);
		border-color: rgba(216, 76, 159, 0.32);
		box-shadow: var(--shadow-lift);
	}

	.pathway-card span {
		align-self: start;
		color: var(--color-spectra-teal);
		font-size: 0.78rem;
		font-weight: 850;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.pathway-card h3 {
		font-size: clamp(2rem, 3vw, 3rem);
	}

	.pathway-card p {
		align-self: end;
		max-width: 18rem;
		font-size: 0.95rem;
		line-height: 1.55;
	}

	@media (min-width: 760px) {
		.principle-layout,
		.signal-panel {
			grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1fr);
		}

		.pathway-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 1000px) {
		.approach-hero-layout {
			grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.44fr);
		}

		.approach-hero-focus {
			justify-self: end;
			padding-bottom: var(--space-8);
		}

		.process-flow {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: var(--space-16);
		}

		.process-flow::before {
			position: absolute;
			top: calc(var(--space-24) + 0.78rem);
			right: 7%;
			left: 7%;
			height: 1px;
			background: linear-gradient(90deg, rgba(40, 156, 176, 0.16), rgba(122, 117, 207, 0.34), rgba(222, 184, 94, 0.2));
			content: "";
		}

		.process-step {
			gap: var(--space-16);
			min-height: 22rem;
			padding: var(--space-24);
		}

		.process-step::after {
			display: none;
		}

		.step-copy p {
			font-size: 0.88rem;
		}

		.process-step ul {
			margin-top: auto;
		}
	}

	@media (min-width: 1180px) {
		.process-flow {
			gap: var(--space-16);
		}

		.process-step {
			min-height: 22.5rem;
		}
	}

	@media (max-width: 760px) {
		.approach-hero {
			padding: clamp(var(--space-40), 10vw, var(--space-56)) 0 var(--space-40);
		}

		.approach-hero h1 {
			max-width: 11ch;
			font-size: clamp(3rem, 13vw, 4rem);
		}

		.approach-hero-focus {
			max-width: 100%;
		}

		.approach-hero-focus span {
			font-size: clamp(2rem, 9vw, 2.8rem);
		}

		.approach-hero-actions .button {
			flex: 1 1 100%;
		}

		.process-flow,
		.pathway-grid {
			margin-top: var(--space-32);
		}

		.pathway-section :global(#pathway-title) {
			white-space: normal;
		}

		.process-step {
			gap: var(--space-16);
		}

		.pathway-card {
			min-height: 13.5rem;
		}
	}
</style>
