---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";

const steps = [
	{
		title: "Understand",
		copy: "Build a fuller picture with symptoms, history, labs, lifestyle, structure, recovery, and goals.",
		details: ["Health story and timeline", "Advanced diagnostic context", "Lifestyle and recovery patterns"],
	},
	{
		title: "Personalize",
		copy: "Translate patterns into a plan that reflects the person, not just isolated data points.",
		details: ["Root-cause pattern review", "Priority setting", "Education and shared decision-making"],
	},
	{
		title: "Optimize",
		copy: "Refine care over time as markers, capacity, symptoms, and lived experience change.",
		details: ["Follow-up interpretation", "Therapy and protocol refinement", "Long-term vitality focus"],
	},
];

const systems = [
	"Metabolism",
	"Hormones",
	"Inflammation",
	"Gut health",
	"Toxins",
	"Sleep",
	"Stress chemistry",
	"Movement",
	"Nervous system",
	"Structure",
	"Mitochondria",
	"Cellular health",
];
---

<Layout
	title="Dr. Lisa's Approach | Root-Cause Functional Medicine"
	description="Understand Dr. Lisa Koche's patient-centered approach to root-cause care, advanced diagnostics, personalized planning, and long-term vitality."
	currentPath="/approach"
>
	<PageHero
		title="Understand the pattern. Personalize the plan. Support the whole person."
		copy="Dr. Lisa's approach combines functional medicine, advanced diagnostics, structural support, performance therapies, and education so care can be more connected and less reactive."
		primaryHref="/services"
		primaryLabel="Explore Services"
		secondaryHref="/contact"
		secondaryLabel="Book Discovery"
		mediaLabel="Clinical methodology visual"
	/>

	<section class="section" aria-labelledby="framework-title">
		<div class="container">
			<SectionIntro
				id="framework-title"
				eyebrow="Framework"
				title="Understand. Personalize. Optimize."
				copy="A simple structure for care that can hold complexity without making the patient experience feel scattered."
			/>
			<div class="framework-grid">
				{steps.map((step, index) => (
					<article class="framework-card">
						<span>{String(index + 1).padStart(2, "0")}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
						<ul>
							{step.details.map((detail) => <li>{detail}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="systems-title">
		<div class="container two-column root-grid">
			<div>
				<p class="eyebrow">What We Look At</p>
				<h2 id="systems-title">Root-cause care looks for relationships, not just results.</h2>
			</div>
			<div>
				<p>
					The body is an interconnected system. Dr. Lisa's team considers how core systems may shape
					symptoms, resilience, recovery, and long-term vitality.
				</p>
				<div class="system-tags" aria-label="Systems reviewed in care">
					{systems.map((system) => <span>{system}</span>)}
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="journey-title">
		<div class="container journey-panel">
			<div>
				<p class="eyebrow">Care Journey</p>
				<h2 id="journey-title">Reclaim, heal, perform, and transcend.</h2>
			</div>
			<p>
				The care journey gives language to a flexible process: stabilize foundations, address deeper
				drivers, strengthen capacity, and support whole-person alignment. The sequence is educational and
				individual plans vary.
			</p>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="connected-title">
		<div class="container connected-grid">
			<SectionIntro
				id="connected-title"
				eyebrow="Connected Care"
				title="The practice works because services are not treated as separate silos."
				copy="Functional medicine, primary care, performance therapies, structural care, aesthetics, and healing arts can each answer a different part of the same human story."
			/>
			<div class="connection-list">
				<a href="/services/functional-medicine">Functional medicine</a>
				<a href="/services/performance-longevity">Performance center</a>
				<a href="/services/chiropractic-care">Structural care</a>
				<a href="/services/aesthetics-regenerative-wellness">Functional aesthetics</a>
				<a href="/services/healing-arts-collective">Healing Arts Collective</a>
			</div>
		</div>
	</section>

	<CTASection
		title="Find the doorway that matches your physiology."
		copy="Explore the services hub or start a discovery conversation to clarify where care should begin."
		primaryHref="/services"
		primaryLabel="Explore Services"
		secondaryHref="/contact"
		secondaryLabel="Book Discovery"
	/>
</Layout>

<style>
	.framework-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.framework-card {
		padding: clamp(1.3rem, 3vw, 2rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.68)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-card);
	}

	.framework-card span {
		color: var(--color-spectra-teal);
		font-family: var(--font-display);
	}

	.framework-card h3,
	.root-grid h2,
	.journey-panel h2 {
		margin: var(--space-md) 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4vw, 3.2rem);
		font-weight: 400;
		line-height: 1.05;
	}

	.root-grid h2,
	.journey-panel h2 {
		margin-top: 0;
	}

	.framework-card p,
	.root-grid p,
	.journey-panel p {
		color: var(--color-muted);
	}

	.framework-card ul {
		display: grid;
		gap: 0.5rem;
		padding: 0;
		margin: var(--space-lg) 0 0;
		list-style: none;
	}

	.framework-card li {
		padding-top: 0.6rem;
		border-top: 1px solid rgba(80, 166, 163, 0.16);
		color: var(--color-muted);
		font-size: 0.92rem;
	}

	.root-grid {
		align-items: start;
	}

	.system-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-top: var(--space-lg);
	}

	.system-tags span {
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: 0.55rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.58);
		color: var(--color-muted);
		font-size: 0.84rem;
		font-weight: 700;
	}

	.journey-panel {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
		padding: clamp(1.5rem, 5vw, 4rem);
		border: 1px solid rgba(80, 166, 163, 0.28);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.8), rgba(220, 239, 238, 0.58)),
			radial-gradient(circle at 85% 16%, rgba(125, 183, 217, 0.22), transparent 16rem),
			radial-gradient(circle at 12% 82%, rgba(216, 76, 159, 0.12), transparent 15rem);
		box-shadow: var(--shadow-spectrum);
	}

	.connected-grid {
		display: grid;
		gap: var(--space-2xl);
	}

	.connection-list {
		display: grid;
		gap: var(--space-md);
	}

	.connection-list a {
		padding: var(--space-md) 0;
		border-top: 1px solid rgba(80, 166, 163, 0.18);
		color: var(--color-deep-evergreen);
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.2vw, 1.85rem);
		line-height: 1.08;
	}

	@media (min-width: 820px) {
		.framework-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 940px) {
		.journey-panel,
		.connected-grid {
			grid-template-columns: 0.88fr 1fr;
		}
	}
</style>
