---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";

const steps = [
	{
		title: "Understand",
		copy: "Build a fuller clinical picture using history, symptoms, diagnostics, lifestyle context, and goals.",
		details: ["Health story and timeline", "Relevant labs and diagnostics", "Lifestyle and recovery context"],
	},
	{
		title: "Personalize",
		copy: "Translate patterns into a plan that respects the person, not just isolated data points.",
		details: ["Root-cause pattern review", "Prioritized care planning", "Education for better decisions"],
	},
	{
		title: "Optimize",
		copy: "Refine the strategy over time as markers, capacity, and lived experience change.",
		details: ["Follow-up interpretation", "Protocol refinement", "Long-term resilience focus"],
	},
];
---

<Layout
	title="Approach | Dr. Lisa Koche"
	description="Explore a whole-system, data-informed clinical approach to personalized longevity and health optimization."
	currentPath="/approach"
>
	<PageHero
		title="A more complete way to understand and optimize health."
		copy="The approach looks for meaningful patterns across physiology, lifestyle, symptoms, diagnostics, and long-term goals."
		primaryHref="/programs"
		primaryLabel="Explore Programs"
		secondaryHref="/contact"
		secondaryLabel="Start Assessment"
		mediaLabel="Clinical Methodology Visual Placeholder"
	/>

	<section class="section" aria-labelledby="framework-title">
		<div class="container">
			<SectionIntro
				id="framework-title"
				eyebrow="Framework"
				title="Understand. Personalize. Optimize."
				copy="A simple structure for care that can hold complexity without making the experience feel overwhelming."
			/>
			<div class="framework-grid">
				{steps.map((step, index) => (
					<article class="framework-card">
						<span>{String(index + 1).padStart(2, "0")}</span>
						<h3>{step.title}</h3>
						<p>{step.copy}</p>
						<ul>
							{step.details.map((detail) => <li>{detail}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="root-title">
		<div class="container two-column root-grid">
			<div>
				<p class="eyebrow">Whole-System Philosophy</p>
				<h2 id="root-title">Root-cause care looks for relationships, not just results.</h2>
			</div>
			<div class="editorial-copy">
				<p>
					The body is an interconnected system. Metabolism, hormones, inflammation, immune signaling,
					sleep, stress chemistry, digestion, nutrition, toxins, movement, and emotional load can all
					shape how a person feels and functions.
				</p>
				<p>
					This methodology is designed to make those relationships easier to see, prioritize, and
					translate into careful next steps.
				</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="technology-title">
		<div class="container intelligence-panel">
			<div>
				<p class="eyebrow">Technology & Intelligence</p>
				<h2 id="technology-title">Data can strengthen care when it remains in service of the person.</h2>
				<p>
					Diagnostics, tracking, and longitudinal insight can help reveal patterns over time. This
					concept describes a data-informed clinical point of view, not a live software platform or
					patient portal.
				</p>
				<!-- Final platform, technology, tracking, and legal language should be approved before production. -->
			</div>
			<aside aria-label="Data-informed care placeholders">
				<span>01</span>
				<strong>Clinical interpretation</strong>
				<span>02</span>
				<strong>Longitudinal context</strong>
				<span>03</span>
				<strong>Personalized refinement</strong>
			</aside>
		</div>
	</section>

	<CTASection
		title="Find the pathway that matches your physiology."
		copy="Explore the program overview or start an assessment conversation to clarify where care should begin."
		primaryHref="/programs"
		primaryLabel="Explore Programs"
		secondaryHref="/contact"
		secondaryLabel="Start Assessment"
	/>
</Layout>

<style>
	.framework-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.framework-card {
		padding: clamp(1.3rem, 3vw, 2rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 255, 255, 0.68)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-card);
	}

	.framework-card span {
		color: var(--color-spectra-teal);
		font-family: var(--font-display);
	}

	.framework-card h3,
	.root-grid h2,
	.intelligence-panel h2 {
		margin: var(--space-md) 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4vw, 3.2rem);
		font-weight: 400;
		line-height: 1.05;
	}

	.framework-card p,
	.editorial-copy p,
	.intelligence-panel p {
		color: var(--color-muted);
	}

	.framework-card ul {
		display: grid;
		gap: 0.5rem;
		padding: 0;
		margin: var(--space-lg) 0 0;
		list-style: none;
	}

	.framework-card li {
		padding-top: 0.6rem;
		border-top: 1px solid rgba(80, 166, 163, 0.16);
		color: var(--color-muted);
		font-size: 0.92rem;
	}

	.root-grid {
		align-items: start;
	}

	.editorial-copy {
		display: grid;
		gap: var(--space-md);
	}

	.editorial-copy p {
		margin: 0;
	}

	.intelligence-panel {
		display: grid;
		gap: var(--space-2xl);
		padding: clamp(1.5rem, 5vw, 4rem);
		border: 1px solid rgba(80, 166, 163, 0.28);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.8), rgba(220, 239, 238, 0.58)),
			radial-gradient(circle at 85% 16%, rgba(125, 183, 217, 0.22), transparent 16rem),
			radial-gradient(circle at 12% 82%, rgba(216, 76, 159, 0.12), transparent 15rem);
		box-shadow: var(--shadow-spectrum);
	}

	.intelligence-panel h2 {
		max-width: 48rem;
	}

	.intelligence-panel p {
		max-width: 42rem;
	}

	.intelligence-panel aside {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-sm) var(--space-md);
		align-content: start;
	}

	.intelligence-panel aside span {
		color: var(--color-spectra-teal);
		font-family: var(--font-display);
	}

	.intelligence-panel aside strong {
		padding-bottom: var(--space-md);
		border-bottom: 1px solid rgba(80, 166, 163, 0.18);
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 400;
	}

	@media (min-width: 820px) {
		.framework-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.intelligence-panel {
			grid-template-columns: 1fr minmax(18rem, 0.48fr);
			align-items: start;
		}
	}
</style>
