---
import CTASection from "../../components/CTASection.astro";
import Layout from "../../components/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { articleResources } from "../../data/resources";
import { type ServiceCategory, serviceCategories, services } from "../../data/services";
import { siteLinks } from "../../data/site";

const categories = Object.keys(serviceCategories) as ServiceCategory[];
---

<Layout
	title="Services | Dr. Lisa Koche"
	description="Explore functional medicine, longevity therapies, IV nutrition, applied kinesiology, chiropractic care, hormone support, aesthetics, and specialty wellness services connected to Dr. Lisa's Tampa clinical home."
	currentPath="/services"
>
	<PageHero
		title="A full spectrum of care through Dr. Lisa's root-cause lens."
		copy="Dr. Lisa's Tampa clinical home brings functional medicine, primary care, structural support, performance therapies, and regenerative wellness into one calmer care ecosystem."
		primaryHref={siteLinks.discoveryCall}
		primaryLabel="Book a Discovery Call"
		secondaryHref="/approach"
		secondaryLabel="View Approach"
		mediaLabel="Dr. Lisa service imagery"
	/>

	<section class="section" aria-labelledby="category-title">
		<div class="container">
			<SectionIntro
				id="category-title"
				eyebrow="Care Map"
				title="Start with the category that matches what you need to understand."
				copy="This page organizes Dr. Lisa's clinical ecosystem into clearer care families while preserving the depth patients expect."
			/>
			<div class="category-grid" aria-label="Service categories">
				{
					categories.map((category) => (
						<a href={`#${category}`} class={`category-tile category-${category}`}>
							<span aria-hidden="true"></span>
							<strong>{serviceCategories[category].label}</strong>
							<small>{serviceCategories[category].copy}</small>
						</a>
					))
				}
			</div>
		</div>
	</section>

	{
		categories.map((category, index) => (
			<section class:list={["section", index % 2 === 0 && "section-soft"]} id={category} aria-labelledby={`${category}-title`}>
				<div class="container">
					<SectionIntro
						id={`${category}-title`}
						eyebrow="Services"
						title={serviceCategories[category].label}
						copy={serviceCategories[category].copy}
					/>
					<div class="service-grid">
						{services.filter((service) => service.category === category).map((service) => <ServiceCard service={service} />)}
					</div>
				</div>
			</section>
		))
	}

	<section class="section" aria-labelledby="membership-title">
		<div class="container membership-panel">
			<div>
				<p class="eyebrow">Clinical Care</p>
				<h2 id="membership-title">A more connected way to access the full spectrum of care.</h2>
				<p>
					For patients who need deeper continuity, the functional medicine care model can connect clinical
					strategy, coaching, advanced labs, IV support, and performance therapies into a more guided
					relationship.
				</p>
			</div>
			<a class="button button-primary" href="/membership">Explore Care Model</a>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="resource-title">
		<div class="container">
			<SectionIntro
				id="resource-title"
				eyebrow="Learn"
				title="Helpful reading before your first conversation."
				copy="These resources point patients toward the care language and educational themes behind the practice."
			/>
			<div class="resource-grid">
				{articleResources.slice(0, 3).map((resource) => <ResourceCard resource={resource} />)}
			</div>
		</div>
	</section>

	<CTASection
		title="You do not have to pick the perfect service first."
		copy="Start with a discovery call or contact the office. The team can help route your question to the right provider, care path, or therapy."
		primaryHref={siteLinks.discoveryCall}
		primaryLabel="Book Discovery Call"
		secondaryHref="/contact"
		secondaryLabel="Contact the Practice"
	/>
</Layout>

<style>
	.category-grid,
	.service-grid,
	.resource-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.category-tile {
		display: grid;
		gap: var(--space-sm);
		align-content: start;
		min-height: 13rem;
		padding: clamp(1.1rem, 3vw, 1.6rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.66)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-card);
		transition:
			transform var(--transition),
			border-color var(--transition),
			box-shadow var(--transition);
	}

	.category-tile:hover {
		transform: translateY(-3px);
		border-color: rgba(216, 76, 159, 0.32);
		box-shadow: var(--shadow-lift);
	}

	.category-tile span {
		width: 1.1rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--accent-color);
		box-shadow: 0 8px 18px color-mix(in srgb, var(--accent-color), transparent 62%);
	}

	.category-tile strong {
		font-family: var(--font-display);
		font-size: clamp(1.32rem, 2.1vw, 1.82rem);
		font-weight: 400;
		line-height: 1.08;
	}

	.category-tile small {
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.45;
	}

	.category-medical {
		--accent-color: var(--color-spectra-teal);
	}

	.category-performance {
		--accent-color: var(--color-oxygen-blue);
	}

	.category-structural {
		--accent-color: var(--color-spectra-sun);
	}

	.category-aesthetics {
		--accent-color: var(--color-spectra-pink);
	}

	.category-specialty {
		--accent-color: var(--color-spectra-violet);
	}

	.membership-panel {
		display: grid;
		gap: var(--space-xl);
		align-items: end;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid rgba(80, 166, 163, 0.28);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.8), rgba(220, 239, 238, 0.58)),
			radial-gradient(circle at 85% 16%, rgba(125, 183, 217, 0.22), transparent 16rem),
			radial-gradient(circle at 12% 82%, rgba(216, 76, 159, 0.12), transparent 15rem);
		box-shadow: var(--shadow-spectrum);
	}

	.membership-panel h2 {
		max-width: 46rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.05rem, 4vw, 3.8rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.membership-panel p:not(.eyebrow) {
		max-width: 48rem;
		margin: var(--space-md) 0 0;
		color: var(--color-muted);
	}

	.membership-panel .button {
		width: fit-content;
	}

	@media (min-width: 720px) {
		.category-grid,
		.resource-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.service-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 980px) {
		.category-grid {
			grid-template-columns: repeat(5, 1fr);
		}

		.membership-panel {
			grid-template-columns: 1fr auto;
		}
	}

	@media (min-width: 1180px) {
		.service-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
