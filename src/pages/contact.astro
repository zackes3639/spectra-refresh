---
import ContactCard from "../components/ContactCard.astro";
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { practiceInfo, siteLinks } from "../data/site";

const contactOptions = [
	{
		title: "Become a patient",
		copy: "Start here for new patient questions, provider routing, and care pathway fit.",
		href: "/patients",
		label: "Patient information",
	},
	{
		title: "Clinical care discovery",
		copy: "Use a discovery call for functional medicine care questions and current fit.",
		href: siteLinks.discoveryCall,
		label: "Book discovery",
	},
	{
		title: "Performance therapies",
		copy: "Book performance and longevity therapies through the current public Mindbody destination.",
		href: siteLinks.mindbody,
		label: "Book with Mindbody",
	},
	{
		title: "Speaking or media",
		copy: "Route event, interview, podcast, and education inquiries through the speaking page.",
		href: "/speaking",
		label: "Speaking inquiry",
	},
	{
		title: "General question",
		copy: "For non-urgent practice questions, call, email, or use the inquiry form below.",
		href: "#contact-form",
		label: "Prepare inquiry",
	},
];
---

<Layout
	title="Contact Dr. Lisa Koche | Tampa Functional Medicine"
	description="Contact Dr. Lisa Koche's office for patient inquiries, discovery calls, appointments, speaking requests, and general questions."
	currentPath="/contact"
>
	<PageHero
		title="Start with the right conversation."
		copy="Use this page to route patient care, discovery calls, performance therapy, speaking, media, and general office questions while keeping sensitive medical details out of web forms."
		primaryHref={practiceInfo.phoneHref}
		primaryLabel={`Call ${practiceInfo.phone}`}
		secondaryHref="#contact-form"
		secondaryLabel="Prepare Inquiry"
		mediaLabel="Contact imagery"
	/>

	<section class="section" aria-labelledby="options-title">
		<div class="container">
			<SectionIntro
				id="options-title"
				eyebrow="Contact Options"
				title="Choose the inquiry that best fits."
				copy="Clear routing keeps clinical, therapy, education, and media pathways separate so each question reaches the right destination."
			/>
			<div class="contact-grid">
				{contactOptions.map((option) => <ContactCard {...option} />)}
			</div>
		</div>
	</section>

	<section class="section section-soft" id="contact-form" aria-labelledby="form-title">
		<div class="container contact-layout">
			<div>
				<p class="eyebrow">Inquiry</p>
				<h2 id="form-title">Prepare a simple inquiry.</h2>
				<p>
					Use these fields to organize a non-urgent message before contacting the practice. For direct
					communication, call or email the office.
				</p>
				<p class="notice">
					Do not submit protected health information, urgent symptoms, or emergency concerns through
					this form. Call the office for routine questions or call 911 for emergencies.
				</p>
			</div>
			<form class="contact-form" action="#" method="get">
				<label>
					Name
					<input type="text" name="name" autocomplete="name" />
				</label>
				<label>
					Email
					<input type="email" name="email" autocomplete="email" />
				</label>
				<label>
					Inquiry type
					<select name="inquiry">
						<option>Patient inquiry</option>
						<option>Clinical care discovery</option>
						<option>Performance therapy</option>
						<option>Speaking / media</option>
						<option>General question</option>
					</select>
				</label>
				<label>
					Message
					<textarea name="message" rows="5"></textarea>
				</label>
				<button class="button button-primary" type="submit">Prepare Inquiry</button>
			</form>
		</div>
	</section>

	<section class="section" aria-labelledby="practice-title">
		<div class="container practice-panel">
			<div>
				<p class="eyebrow">Practice Information</p>
				<h2 id="practice-title">Dr. Lisa's Tampa clinical home.</h2>
			</div>
			<div class="practice-details">
				<a href={practiceInfo.phoneHref}>{practiceInfo.phone}</a>
				<a href={practiceInfo.emailHref}>{practiceInfo.email}</a>
				<a href={siteLinks.maps} target="_blank" rel="noopener noreferrer">{practiceInfo.address}</a>
				<a href={siteLinks.patientPortal} target="_blank" rel="noopener noreferrer">Patient Portal</a>
				<a href={siteLinks.mindbody} target="_blank" rel="noopener noreferrer">Mindbody Booking</a>
			</div>
		</div>
	</section>

	<CTASection
		title="Prefer to understand the pathways first?"
		copy="Explore services or patient information before reaching out if you are not sure where your question belongs."
		primaryHref="/services"
		primaryLabel="Explore Services"
		secondaryHref="/patients"
		secondaryLabel="Patient Information"
	/>
</Layout>

<style>
	.contact-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.contact-layout,
	.practice-panel {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.contact-layout h2,
	.practice-panel h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 5vw, 4.6rem);
		font-weight: 400;
		line-height: 1;
	}

	.contact-layout p,
	.practice-panel p {
		color: var(--color-muted);
	}

	.notice {
		padding: var(--space-md);
		border: 1px solid rgba(216, 76, 159, 0.22);
		border-radius: var(--radius-md);
		background: rgba(255, 255, 255, 0.62);
	}

	.contact-form {
		display: grid;
		gap: var(--space-md);
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.68)),
			var(--gradient-spectrum-soft);
		box-shadow: var(--shadow-spectrum);
	}

	label {
		display: grid;
		gap: var(--space-xs);
		color: var(--color-spectra-teal);
		font-size: 0.84rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	input,
	select,
	textarea {
		width: 100%;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.78);
		color: var(--color-text);
		font-size: 1rem;
		letter-spacing: 0;
		text-transform: none;
	}

	input:focus,
	select:focus,
	textarea:focus {
		border-color: rgba(216, 76, 159, 0.42);
		box-shadow: 0 0 0 4px rgba(80, 166, 163, 0.16);
		outline: none;
	}

	input,
	select {
		min-height: 3rem;
		padding: 0 0.9rem;
	}

	textarea {
		padding: 0.8rem 0.9rem;
		resize: vertical;
	}

	.contact-form .button {
		width: fit-content;
		margin-top: var(--space-sm);
	}

	.practice-panel {
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.78), rgba(220, 239, 238, 0.48)),
			radial-gradient(circle at 88% 18%, rgba(244, 201, 93, 0.16), transparent 14rem);
		box-shadow: var(--shadow-card);
	}

	.practice-details {
		display: grid;
		gap: var(--space-md);
	}

	.practice-details a {
		padding: var(--space-md) 0;
		border-top: 1px solid rgba(80, 166, 163, 0.18);
		color: var(--color-deep-evergreen);
		font-weight: 800;
	}

	@media (min-width: 760px) {
		.contact-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 900px) {
		.contact-layout,
		.practice-panel {
			grid-template-columns: 0.8fr 1fr;
		}

		.contact-grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}
</style>
