---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import TeamMemberCard from "../components/TeamMemberCard.astro";
import { practiceInfo } from "../data/site";
import { teamMembers } from "../data/team";
---

<Layout
	title="Care Team | Dr. Lisa Koche"
	description="Meet the physicians, nurse practitioners, chiropractors, and care partners connected to Dr. Lisa Koche's Tampa clinical practice."
	currentPath="/team"
>
	<PageHero
		title="Meet the clinical team around Dr. Lisa's work."
		copy="Dr. Lisa's Tampa practice brings physicians, nurse practitioners, structural care providers, and wellness partners together around deeper listening, better context, and long-term vitality."
		primaryHref="/contact"
		primaryLabel="Contact the Practice"
		secondaryHref="/services"
		secondaryLabel="Explore Services"
		mediaLabel="Dr. Lisa team imagery"
		imageSrc="/images/dr-lisa-koche-headshot.jpeg"
		imageAlt="Dr. Lisa Koche"
		mediaType="portrait"
	/>

	<section class="section" aria-labelledby="providers-title">
		<div class="container">
			<SectionIntro
				id="providers-title"
				eyebrow="Providers"
				title="A collaborative team for whole-person care."
				copy="Meet the clinicians, structural care providers, and wellness partners who help patients find the right next step."
			/>
			<div class="team-grid">
				{teamMembers.map((member) => <TeamMemberCard member={member} />)}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="approach-title">
		<div class="container team-approach">
			<div>
				<p class="eyebrow">Team Approach</p>
				<h2 id="approach-title">Medical care, wellness support, and follow-through in one practice.</h2>
			</div>
			<div>
				<p>
					The care model works best when providers can compare the clinical story with lifestyle,
					diagnostics, structural needs, performance therapies, and coaching support. The goal is a
					clearer plan, not a louder menu.
				</p>
				<p>
					Insurance participation and scheduling options can change. Patients should confirm directly
					with the practice and their insurance company before assuming coverage.
				</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="insurance-title">
		<div class="container insurance-panel">
			<p class="eyebrow">Insurance Note</p>
			<h2 id="insurance-title">Confirm coverage before scheduling.</h2>
			<p>
				Current live-site direction indicates Dr. Angeline Galiano and Rodney Morillo may accept many PPO
				policies for primary care, while other providers are generally self-pay. The practice does not appear
				to accept Medicare, Medicare replacement, or Medicare Advantage plans. Confirm coverage directly
				with the practice and your insurance company before scheduling.
			</p>
			<a class="button button-primary" href={practiceInfo.phoneHref}>Call {practiceInfo.phone}</a>
		</div>
	</section>

	<CTASection
		title="Not sure which provider fits?"
		copy="Start with the office team. They can help route your question to patient care, structural care, performance therapies, or a provider-specific next step."
		primaryHref="/contact"
		primaryLabel="Contact the Practice"
		secondaryHref="/patients"
		secondaryLabel="Patient Information"
	/>
</Layout>

<style>
	.team-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.team-approach,
	.insurance-panel {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.team-approach h2,
	.insurance-panel h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.7rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.team-approach p,
	.insurance-panel p {
		color: var(--color-muted);
	}

	.insurance-panel {
		max-width: 62rem;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.78), rgba(220, 239, 238, 0.48)),
			radial-gradient(circle at 88% 18%, rgba(244, 201, 93, 0.16), transparent 14rem);
		box-shadow: var(--shadow-card);
	}

	.insurance-panel .button {
		width: fit-content;
	}

	@media (min-width: 760px) {
		.team-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1080px) {
		.team-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.team-approach {
			grid-template-columns: 0.9fr 1fr;
		}
	}
</style>
