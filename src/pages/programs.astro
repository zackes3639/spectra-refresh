---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ProgramCard from "../components/ProgramCard.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { programs } from "../data/programs";
import { siteLinks } from "../data/site";
---

<Layout
	title="Programs & Education | Dr. Lisa Koche"
	description="Explore Dr. Lisa Koche education pathways for longevity, recovery, resilience, and whole-person health literacy"
	currentPath="/programs"
>
	<PageHero
		title="Dr. Lisa's education pathways for healing, resilience, and longevity"
		copy="These programs are Dr. Lisa learning pathways for education, self-advocacy, and a clearer conversation about your health"
		primaryHref="/contact"
		primaryLabel="Ask About Fit"
		secondaryHref="/resources"
		secondaryLabel="View Resources"
		mediaLabel="Programs brand imagery"
	/>

	<section class="section" aria-labelledby="program-intro-title">
		<div class="container intro-panel">
			<p class="eyebrow">Overview</p>
			<h2 id="program-intro-title">A clearer structure for learning and self-advocacy</h2>
			<p>
				Each pathway is designed to connect physiology, lifestyle, symptoms, and goals into more useful
				questions. These educational pages are for orientation, reflection, and health literacy
			</p>
		</div>
	</section>

	<section class="section section-soft" id="program-list" aria-labelledby="program-list-title">
		<div class="container">
			<SectionIntro
				id="program-list-title"
				eyebrow="Flagship Programs"
				title="Choose the path that matches the pattern you want to understand"
				copy="These pathways help organize the next question and point people back to Dr. Lisa's larger education ecosystem"
			/>
			<div class="program-grid">
				{
					programs.map((program) => (
						<ProgramCard
							title={program.title}
							copy={program.summary}
							href={`/programs/${program.slug}`}
							accent={program.accent}
							items={program.benefits}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="path-title">
		<div class="container path-panel">
			<div>
				<p class="eyebrow">Which path is right for you?</p>
				<h2 id="path-title">Start with the pattern you most want to understand</h2>
			</div>
			<div class="path-grid">
				{programs.map((program) => (
					<a class={`path-item accent-${program.accent}`} href={`/programs/${program.slug}`}>
						<span aria-hidden="true"></span>
						<strong>{program.title}</strong>
						<small>{program.benefits[0]}</small>
					</a>
				))}
			</div>
		</div>
	</section>

	<CTASection
		title="Education can organize the next question"
		copy="Explore Dr. Lisa's resources and programs, or continue to Spectra Wellness for practice details"
		primaryHref="/resources"
		primaryLabel="Explore Resources"
		secondaryHref={siteLinks.spectraWellness}
		secondaryLabel="Spectra Wellness"
	/>
</Layout>

<style>
	.intro-panel {
		max-width: 58rem;
	}

	.intro-panel h2,
	.path-panel h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.2rem, 5vw, 4.8rem);
		font-weight: 400;
		line-height: 1;
	}

	.intro-panel p:not(.eyebrow) {
		max-width: 48rem;
		margin: var(--space-lg) 0 0;
		color: var(--color-muted);
		font-size: clamp(1rem, 1.5vw, 1.15rem);
	}

	.program-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.path-panel {
		display: grid;
		gap: var(--space-2xl);
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.78), rgba(220, 239, 238, 0.5)),
			radial-gradient(circle at 90% 18%, rgba(216, 76, 159, 0.12), transparent 16rem),
			radial-gradient(circle at 12% 88%, rgba(244, 201, 93, 0.16), transparent 15rem);
		box-shadow: var(--shadow-spectrum);
	}

	.path-grid {
		display: grid;
		gap: var(--space-md);
	}

	.path-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.2rem var(--space-md);
		align-items: center;
		padding-block: var(--space-md);
		border-top: 1px solid rgba(80, 166, 163, 0.18);
	}

	.path-item span {
		grid-row: span 2;
		width: 1rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--accent-color);
	}

	.path-item strong {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 400;
		line-height: 1.1;
	}

	.path-item small {
		color: var(--color-muted);
		font-size: 0.88rem;
	}

	.accent-gold {
		--accent-color: var(--color-spectra-sun);
	}

	.accent-blue {
		--accent-color: var(--color-oxygen-blue);
	}

	.accent-lavender {
		--accent-color: var(--color-recovery-lavender);
	}

	.accent-coral {
		--accent-color: var(--color-warm-vitality-coral);
	}

	@media (min-width: 760px) {
		.program-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 980px) {
		.path-panel {
			grid-template-columns: 0.9fr 1fr;
			align-items: start;
		}
	}

	@media (min-width: 1180px) {
		.program-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
