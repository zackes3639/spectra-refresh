---
import CTASection from "../components/CTASection.astro";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ResourceCard from "../components/ResourceCard.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { articleResources, featuredResources } from "../data/resources";
import { siteLinks } from "../data/site";
---

<Layout
	title="Resources | Dr. Lisa Koche"
	description="Free guides, health education, courses, articles, and curated learning pathways from Dr. Lisa Koche."
	currentPath="/resources"
>
	<PageHero
		title="Start learning how your body is communicating."
		copy="A Dr. Lisa resource hub for free guides, courses, articles, favorites, and carefully curated wellness pathways."
		primaryHref="#free-resources"
		primaryLabel="Browse Resources"
		secondaryHref={siteLinks.drLisaCourses}
		secondaryLabel="View Courses"
		mediaLabel="Resource library imagery"
	/>

	<section class="section" id="free-resources" aria-labelledby="free-title">
		<div class="container">
			<SectionIntro
				id="free-title"
				eyebrow="Free Resources"
				title="Begin with accessible education, not overwhelm."
				copy="These links route to Dr. Lisa's current education ecosystem or approved public resources."
			/>
			<div class="resource-grid featured-grid">
				{featuredResources.map((resource) => <ResourceCard resource={resource} featured />)}
			</div>
		</div>
	</section>

	<section class="section section-soft" aria-labelledby="articles-title">
		<div class="container">
			<SectionIntro
				id="articles-title"
				eyebrow="Articles"
				title="Helpful reading for curious patients."
				copy="Articles remain hosted externally and are linked here so patients can find the current public versions."
			/>
			<div class="resource-grid">
				{articleResources.map((resource) => <ResourceCard resource={resource} />)}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="all-title">
		<div class="container resource-note">
			<div>
				<p class="eyebrow">Library</p>
				<h2 id="all-title">Courses, favorites, and clinical care should stay clearly separated.</h2>
			</div>
			<p>
				Resources can educate and orient, but they are not a substitute for individualized medical care.
				Product favorites and courses are hosted externally and should include any required disclosures in
				their own checkout or learning environments.
			</p>
		</div>
	</section>

	<CTASection
		title="Want care instead of more content?"
		copy="If your question is clinical, begin with the office team so you can be routed toward the right provider, service, or care conversation."
		primaryHref="/services"
		primaryLabel="Explore Services"
		secondaryHref="/contact"
		secondaryLabel="Contact"
	/>
</Layout>

<style>
	.resource-grid {
		display: grid;
		gap: var(--space-lg);
		margin-top: var(--space-2xl);
	}

	.resource-note {
		display: grid;
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			linear-gradient(150deg, rgba(255, 255, 255, 0.78), rgba(220, 239, 238, 0.48)),
			radial-gradient(circle at 88% 18%, rgba(244, 201, 93, 0.16), transparent 14rem);
		box-shadow: var(--shadow-card);
	}

	.resource-note h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3.6rem);
		font-weight: 400;
		line-height: 1.04;
	}

	.resource-note p:not(.eyebrow) {
		margin: 0;
		color: var(--color-muted);
	}

	@media (min-width: 760px) {
		.resource-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 980px) {
		.featured-grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.resource-note {
			grid-template-columns: 0.9fr 1fr;
		}
	}
</style>
